+      const manager = track(new HistoryManager());
+      startup = manager.startupTasks;
+      await startupWriteStarted.promise;
+
+      // Startup is paused before orphan recovery, so a directory read at this
+      // point can only be the backup entering. It is called synchronously
+      // before createSafetyBackup's first await. No event-loop timing is used.
