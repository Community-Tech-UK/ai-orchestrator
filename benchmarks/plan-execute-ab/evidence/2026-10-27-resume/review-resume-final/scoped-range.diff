+  solved: number,
+  runs: number,
+  avgClaudeTokens = 1_000_000,
+  avgLocalTokens = 0,
+  tasks = runs,
+): ArmSummary {
+  return {
+    armId,
+    runs,
+    solved,
+    solvedRate: runs > 0 ? solved / runs : 0,
+    hiddenTestPass: solved,
+    damageClean: runs,
+    avgDurationMs: 60_000,
+    avgCoderOutputTokens: 10_000,
+    avgClaudeTokens,
+    avgLocalTokens,
+    judgeWins: 0,
+    judgeLosses: 0,
+    judgeTies: 0,
+    judgeUnavailable: 0,
+    failureModes: { looped: 0, toolCallErrors: 0, hitTurnCap: 0, gaveUp: 0, error: 0 },
