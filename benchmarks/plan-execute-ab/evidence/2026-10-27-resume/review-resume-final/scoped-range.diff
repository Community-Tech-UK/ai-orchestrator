+import { createServer, request as httpRequest } from 'http';
+import type { AddressInfo, Socket } from 'net';
+import { describe, expect, it } from 'vitest';
+import { isConnectClassError, isRetryableUpstreamError, normalizeBody, startProxy } from './local-anthropic-proxy';
+
+function freePort(): Promise<number> {
+  return new Promise((resolve) => {
+    const probe = createServer();
+    probe.listen(0, '127.0.0.1', () => {
+      const { port } = probe.address() as AddressInfo;
+      probe.close(() => resolve(port));
+    });
+  });
+}
+
+function waitUntil(predicate: () => boolean, timeoutMs: number): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const started = Date.now();
+    const check = (): void => {
+      if (predicate()) {
+        resolve();
+        return;
+      }
+      if (Date.now() - started > timeoutMs) {
+        reject(new Error(`condition not met within ${timeoutMs}ms`));
+        return;
+      }
+      setTimeout(check, 25);
+    };
+    check();
+  });
+}
+
+/** An upstream that accepts requests and never answers (a hung generation). */
+function pendingUpstream(): Promise<{
+  port: number;
+  openSockets: () => number;
+  requests: () => number;
+  close: () => Promise<void>;
+}> {
+  return new Promise((resolve) => {
+    const sockets = new Set<Socket>();
+    let requestCount = 0;
+    const server = createServer(() => {
+      requestCount += 1;
+    });
+    server.on('connection', (socket) => {
+      sockets.add(socket);
+      socket.on('close', () => sockets.delete(socket));
+    });
+    server.listen(0, '127.0.0.1', () => {
+      const { port } = server.address() as AddressInfo;
+      resolve({
+        port,
+        openSockets: () => sockets.size,
+        requests: () => requestCount,
+        close: () => new Promise<void>((done) => {
+          for (const socket of sockets) socket.destroy();
+          server.close(() => done());
+        }),
+      });
+    });
+  });
+}
+
+function proxyPort(server: ReturnType<typeof createServer>): Promise<number> {
+  return new Promise((resolve) => {
+    const check = (): void => {
+      const addr = server.address();
+      if (addr && typeof addr === 'object') resolve(addr.port);
+      else setTimeout(check, 10);
+    };
+    check();
+  });
+}
+
+function post(port: number, body: string): Promise<{ status: number; text: string }> {
+  return new Promise((resolve, reject) => {
+    const req = httpRequest(
+      { hostname: '127.0.0.1', port, path: '/v1/messages', method: 'POST', headers: { 'content-type': 'application/json' } },
+      (res) => {
+        let text = '';
+        res.on('data', (c: Buffer) => { text += c.toString('utf8'); });
+        res.on('end', () => resolve({ status: res.statusCode ?? 0, text }));
+      },
+    );
+    req.on('error', reject);
+    req.write(body);
+    req.end();
+  });
+}
+
+describe('local anthropic proxy', () => {
+  it('lifts trailing in-array system messages into the system field', () => {
+    const body = {
+      system: [{ type: 'text', text: 'main system' }],
+      messages: [
+        { role: 'user', content: 'hello' },
+        { role: 'system', content: 'context reminder' },
+      ],
+    };
+    const out = normalizeBody(body) as {
+      system: { type: string; text: string }[];
+      messages: { role: string }[];
+    };
+    expect(out.messages.map((m) => m.role)).toEqual(['user']);
+    expect(out.system.map((s) => s.text)).toEqual(['main system', 'context reminder']);
+  });
+
+  it('creates the system field when only in-array system messages exist', () => {
+    const body = {
+      messages: [
+        { role: 'user', content: 'hello' },
+        { role: 'system', content: [{ type: 'text', text: 'blocky' }] },
+      ],
+    };
+    const out = normalizeBody(body) as { system: { text: string }[]; messages: unknown[] };
+    expect(out.messages).toHaveLength(1);
+    expect(out.system[0]?.text).toContain('blocky');
+  });
+
+  it('leaves requests without in-array system messages untouched', () => {
+    const body = { system: [{ type: 'text', text: 's' }], messages: [{ role: 'user', content: 'x' }] };
+    const out = normalizeBody(body);
+    expect(out).toEqual(body);
+  });
+
+  it('preserves the same system prefix when the CLI switches text blocks to a string', () => {
+    const request = (content: unknown) => ({
+      system: [{ type: 'text', text: 'main system' }],
+      messages: [{ role: 'system', content }, { role: 'user', content: 'task' }],
+    });
+    const text = '# Environment\nWorking directory: /tmp/example';
+    expect(normalizeBody(request([{ type: 'text', text }]))).toEqual(normalizeBody(request(text)));
+  });
+
+  it('preserves lifted block boundaries and cache metadata without encoding JSON as text', () => {
+    const blocks = [
+      { type: 'text', text: 'environment' },
+      { type: 'text', text: 'reminder', cache_control: { type: 'ephemeral' } },
+    ];
+    expect(normalizeBody({ messages: [{ role: 'system', content: blocks }] }).system).toEqual(blocks);
+  });
+
+  it('classifies connect-level upstream failures as retryable', () => {
+    expect(isConnectClassError('connect ETIMEDOUT 100.113.93.104:1234')).toBe(true);
+    expect(isConnectClassError('read ETIMEDOUT')).toBe(true);
+    expect(isConnectClassError('connect ECONNREFUSED 127.0.0.1:1234')).toBe(true);
+    expect(isConnectClassError('socket hang up')).toBe(true);
+    expect(isConnectClassError('HTTP 500 from the model')).toBe(false);
+    expect(isRetryableUpstreamError('connect deadline after 15000ms')).toBe(true);
+    expect(isRetryableUpstreamError('response deadline after 600000ms')).toBe(true);
+    expect(isRetryableUpstreamError('HTTP 500 from the model')).toBe(false);
+  });
+
+  it('destroys the active upstream request when the client disconnects', async () => {
+    // Regression: a killed/timed-out agent run closed the downstream side
+    // while the upstream kept generating — orphan inference wedged the server.
+    const upstream = await pendingUpstream();
+    const proxy = startProxy({
+      port: 0,
+      upstream: `http://127.0.0.1:${upstream.port}`,
+      connectDeadlineMs: 100,
+      responseDeadlineMs: 60_000,
+      retryDelayMs: 10,
+      maxAttempts: 5,
+    });
+    const port = await proxyPort(proxy);
+    try {
+      const req = httpRequest(
+        { hostname: '127.0.0.1', port, path: '/v1/messages', method: 'POST', headers: { 'content-type': 'application/json' } },
+        (res) => res.resume(),
+      );
+      req.on('error', () => { /* the client destroy below surfaces as ECONNRESET */ });
+      req.write('{}');
+      req.end();
+      await waitUntil(() => upstream.requests() > 0, 5_000);
+      expect(upstream.openSockets()).toBe(1);
+
+      req.destroy();
+      await waitUntil(() => upstream.openSockets() === 0, 5_000);
+    } finally {
+      await upstream.close();
+      proxy.close();
+    }
+  }, 15_000);
+
+  it('destroys a connected upstream that never answers (response deadline)', async () => {
+    const upstream = await pendingUpstream();
+    const proxy = startProxy({
+      port: 0,
+      upstream: `http://127.0.0.1:${upstream.port}`,
+      connectDeadlineMs: 100,
+      responseDeadlineMs: 150,
+      retryDelayMs: 10,
+      maxAttempts: 0,
+    });
+    const port = await proxyPort(proxy);
+    try {
+      const result = await post(port, '{}');
+      expect(result.status).toBe(502);
+      expect(result.text).toContain('response deadline');
+      await waitUntil(() => upstream.openSockets() === 0, 5_000);
+    } finally {
+      await upstream.close();
+      proxy.close();
+    }
+  }, 15_000);
+
+  it('retries upstream connects until the server appears', async () => {
+    const upstreamPort = await freePort();
+    const proxy = startProxy({ port: 0, upstream: `http://127.0.0.1:${upstreamPort}`, connectDeadlineMs: 100, retryDelayMs: 50, maxAttempts: 40 });
+    const port = await proxyPort(proxy);
+    const probe = createServer((_req, res) => res.end('{"ok":true}'));
+    setTimeout(() => { probe.listen(upstreamPort, '127.0.0.1'); }, 350);
+    const result = await post(port, '{}');
+    expect(result.status).toBe(200);
+    expect(result.text).toBe('{"ok":true}');
+    proxy.close();
+    probe.close();
+  }, 15_000);
+
+  it('returns 502 once the retry budget is exhausted', async () => {
+    const upstreamPort = await freePort();
+    const proxy = startProxy({ port: 0, upstream: `http://127.0.0.1:${upstreamPort}`, connectDeadlineMs: 100, retryDelayMs: 10, maxAttempts: 2 });
+    const port = await proxyPort(proxy);
+    const result = await post(port, '{}');
+    expect(result.status).toBe(502);
+    expect(result.text).toContain('proxy upstream error');
+    proxy.close();
+  }, 15_000);
+});
diff --git a/benchmarks/plan-execute-ab/local-anthropic-proxy.ts b/benchmarks/plan-execute-ab/local-anthropic-proxy.ts
new file mode 100644
index 000000000..27abf425d
--- /dev/null
+++ b/benchmarks/plan-execute-ab/local-anthropic-proxy.ts
@@ -0,0 +1,231 @@
+/**
+ * Minimal Anthropic-message translator for Claude Code against llama.cpp-family
+ * servers (LM Studio). Claude Code 2.x appends trailing `role: "system"`
+ * messages to `messages` (context-management reminders). Several GGUF chat
+ * templates (Qwen3.8's, e.g.) raise "System message must be at the beginning"
+ * on any system message after position 0. This proxy lifts every in-array
+ * system message into the top-level `system` field and forwards the request
+ * unchanged otherwise. Referenced from the plan's step 2 ("through a
+ * translator").
+ */
+import { createServer, request as httpRequest, type ClientRequest, type IncomingMessage } from 'http';
+import { appendFileSync } from 'fs';
+
+interface MessageLike {
+  role?: string;
+  content?: unknown;
+}
+
+export interface NormalizedBody {
+  system?: unknown;
+  messages?: MessageLike[];
+  [key: string]: unknown;
+}
+
+/** Move in-array system messages into the top-level system blocks. */
+export function normalizeBody(parsed: NormalizedBody): NormalizedBody {
+  const messages = Array.isArray(parsed.messages) ? parsed.messages : [];
+  const lifted: unknown[] = [];
+  const kept: MessageLike[] = [];
+  for (const message of messages) {
+    if (message && message.role === 'system') {
+      const content = Array.isArray(message.content)
+        ? message.content
+        : [{ type: 'text', text: typeof message.content === 'string' ? message.content : JSON.stringify(message.content ?? '') }];
+      lifted.push(...content);
+    } else {
+      kept.push(message);
+    }
+  }
+  if (lifted.length === 0) return parsed;
+  const system: unknown[] = Array.isArray(parsed.system)
+    ? [...parsed.system]
+    : parsed.system
+      ? [{ type: 'text', text: String(parsed.system) }]
+      : [];
+  system.push(...lifted);
+  return { ...parsed, system, messages: kept };
+}
+
+export interface ProxyOptions {
+  port: number;
+  upstream: string;
+  logPath?: string;
+  /** Test seam: how long one upstream connect attempt may hang before retry. */
+  connectDeadlineMs?: number;
+  /** Test seam: after a successful connect, how long response headers may take. */
+  responseDeadlineMs?: number;
+  /** Test seam: delay between upstream attempts. */
+  retryDelayMs?: number;
+  /** Test seam: how many upstream attempts before surfacing a 502. */
+  maxAttempts?: number;
+}
+
+/**
+ * Errors that mean "the upstream did not accept or dropped the connection",
+ * not "the model answered with an error". LM Studio 0.4.x stops accepting new
+ * TCP connections while a long generation is in flight (measured 16 Oct:
+ * 6/6 connects time out mid-generation while ICMP to the same host stays 1ms),
+ * which killed agent runs with 502s. These are retried instead of surfaced.
+ */
+export function isConnectClassError(message: string): boolean {
+  return /ETIMEDOUT|ECONNREFUSED|ECONNRESET|EHOSTUNREACH|ENETUNREACH|EPIPE|socket hang up/i.test(message);
+}
+
+/** Errors worth retrying at this layer: the upstream never answered, it did not fail. */
+export function isRetryableUpstreamError(message: string): boolean {
+  return isConnectClassError(message)
+    || message.startsWith('connect deadline')
+    || message.startsWith('response deadline');
+}
+
+const CONNECT_DEADLINE_MS = 15_000;
+const RETRY_DELAY_MS = 2_000;
+const MAX_UPSTREAM_ATTEMPTS = 60;
+// Long prompt processing must fit: the slowest measured prompt speed (~70
+// tok/s on a cold Flash-Next load) needs ~16 min for a 65k-token prompt
+// before the first response byte. Nothing sane is silent for longer.
+const RESPONSE_DEADLINE_MS = 1_200_000;
+
+export function startProxy({
+  port,
+  upstream,
+  logPath,
+  connectDeadlineMs,
+  responseDeadlineMs,
+  retryDelayMs,
+  maxAttempts,
+}: ProxyOptions): ReturnType<typeof createServer> {
+  const up = new URL(upstream);
+  const deadlineMs = connectDeadlineMs ?? CONNECT_DEADLINE_MS;
+  const responseDeadline = responseDeadlineMs ?? RESPONSE_DEADLINE_MS;
+  const delayMs = retryDelayMs ?? RETRY_DELAY_MS;
+  const attemptsMax = maxAttempts ?? MAX_UPSTREAM_ATTEMPTS;
+  const server = createServer((req, res) => {
+    res.on('error', () => { /* A disconnected client is handled by the upstream retry guard. */ });
+    const chunks: Buffer[] = [];
+    req.on('data', (c) => chunks.push(c));
+    req.on('end', () => {
+      let body = Buffer.concat(chunks);
+      if ((req.url ?? '').includes('/v1/messages')) {
+        try {
+          const parsed = JSON.parse(body.toString('utf8'));
+          const before = parsed.messages?.length ?? 0;
+          const normalized = normalizeBody(parsed);
+          body = Buffer.from(JSON.stringify(normalized), 'utf8');
+          const after = normalized.messages?.length ?? 0;
+          if (logPath && before !== after) {
+            appendFileSync(logPath, `${new Date().toISOString()} lifted ${before - after} in-array system message(s) into system field\n`);
+          }
+        } catch {
+          // Non-JSON bodies pass through untouched.
+        }
+      }
+      const fwdHeaders: Record<string, string | string[] | undefined> = {
+        ...req.headers,
+        host: up.host,
+        'content-length': String(body.length),
+      };
+      // The body is buffered and re-sent with a content-length; a forwarded
+      // chunked transfer-encoding would make the upstream reject the request.
+      delete fwdHeaders['transfer-encoding'];
+
+      let aborted = false;
+      let activeFwd: ClientRequest | null = null;
+      let activeUpRes: IncomingMessage | null = null;
+      const abortUpstream = (): void => {
+        activeUpRes?.destroy();
+        activeUpRes = null;
+        activeFwd?.destroy();
+        activeFwd = null;
+      };
+      // A killed/timed-out agent run closes the downstream connection while the
+      // upstream may still be generating. Leaving that inference running wedges
+      // the serving layer (recorded: accept-blocking after orphan generations),
+      // so the active upstream request is destroyed with the client.
+      res.on('close', () => {
+        if (res.writableFinished) return;
+        aborted = true;
+        abortUpstream();
+        if (logPath) appendFileSync(logPath, `${new Date().toISOString()} client disconnected - aborted the upstream request\n`);
+      });
+
+      const sendUpstream = (attempt: number): void => {
+        if (aborted || res.writableEnded || res.destroyed) return;
+        const fwd = httpRequest(
+          {
+            hostname: up.hostname,
+            port: up.port,
+            path: req.url,
+            method: req.method,
+            headers: fwdHeaders,
+            agent: false,
+          },
+          (upRes) => {
+            clearTimeout(connectTimer);
+            clearTimeout(responseTimer);
+            if (aborted) {
+              upRes.destroy();
+              fwd.destroy();
+              return;
+            }
+            activeUpRes = upRes;
+            if (!res.headersSent) res.writeHead(upRes.statusCode || 502, upRes.headers);
+            upRes.on('error', () => { res.destroy(); });
+            upRes.pipe(res);
+          },
+        );
+        activeFwd = fwd;
+        let connected = false;
+        let responseTimer: NodeJS.Timeout | undefined;
+        const connectTimer = setTimeout(() => {
+          if (!connected) fwd.destroy(new Error(`connect deadline after ${deadlineMs}ms`));
+        }, deadlineMs);
+        fwd.on('socket', (socket) => {
+          const onConnect = (): void => {
+            connected = true;
+            clearTimeout(connectTimer);
+            // The connect timer alone leaves a connected-but-silent upstream
+            // unbounded; response headers get their own deadline from here.
+            responseTimer = setTimeout(() => {
+              fwd.destroy(new Error(`response deadline after ${responseDeadline}ms`));
+            }, responseDeadline);
+          };
+          socket.once('connect', onConnect);
+          socket.once('secureConnect', onConnect);
+        });
+        fwd.on('error', (err) => {
+          clearTimeout(connectTimer);
+          clearTimeout(responseTimer);
+          const clientGone = aborted || res.writableEnded || res.destroyed;
+          if (!clientGone && attempt < attemptsMax && isRetryableUpstreamError(err.message)) {
+            if (logPath) appendFileSync(logPath, `${new Date().toISOString()} upstream retry ${attempt + 1} after: ${err.message}\n`);
+            setTimeout(() => sendUpstream(attempt + 1), delayMs);
+            return;
+          }
+          if (logPath) appendFileSync(logPath, `${new Date().toISOString()} upstream error: ${err.message}\n`);
+          if (!res.headersSent) {
+            res.writeHead(502, { 'content-type': 'text/plain' });
+            res.end(`proxy upstream error: ${err.message}`);
+          } else {
+            res.destroy();
+          }
+        });
+        fwd.write(body);
+        fwd.end();
+      };
+      sendUpstream(0);
+    });
+  });
+  server.on('clientError', (_err, socket) => { socket.destroy(); });
+  server.listen(port, '127.0.0.1');
+  return server;
+}
+
+if (process.argv[1]?.endsWith('local-anthropic-proxy.ts')) {
+  const [upstream, portArg, logPath] = process.argv.slice(2);
+  const port = Number(portArg ?? 8900);
+  const target = upstream ?? 'http://127.0.0.1:1234';
+  startProxy({ port, upstream: target, logPath });
+  process.stdout.write(`local-anthropic-proxy on 127.0.0.1:${port} -> ${target}\n`);
+}
