+import { describe, expect, it, vi } from 'vitest';
+import {
+  buildPlainEnvelopeChunks,
+  chunkedLength,
+  serializeJsonChunks,
+} from './continuity-json-chunks';
+
+const sparse: unknown[] = [1, , 3]; // eslint-disable-line no-sparse-arrays
+const keyed = { toJSON: (key: string) => `key:${key}` };
+
+const fixtures: Record<string, unknown> = {
+  session: { id: 'a', conversationHistory: [{ role: 'user', content: 'hi' }, { n: 1, ok: true, x: null }] },
+  holes: sparse,
+  omitted: { a: undefined, b: () => 1, c: Symbol('s'), d: [undefined, () => 1, Symbol('s')], e: 1 },
+  date: { when: new Date(0) },
+  toJSON: { a: keyed, list: [keyed, keyed] },
+  boxed: [new Number(3), new String('s😀'), new Boolean(false)],
+  mapSet: { m: new Map([[1, 2]]), s: new Set([1]) },
+  numbers: [-0, NaN, Infinity, 1.5e300],
+  emoji: { text: 'a😀b😀😀c😀' },
+  surrogates: ['\ud800', '\udc00', 'x\ud800y', '\udc00\ud800'],
+  escapes: { s: 'q"uote\\ back\u0001\n\t ' },
+  primitive: 'just a string',
+  number: 42,
+  nullValue: null,
+};
+
+describe('serializeJsonChunks', () => {
+  for (const [name, value] of Object.entries(fixtures)) {
+    for (const chunkChars of [1, 7, 64, undefined]) {
+      it(`matches JSON.stringify for ${name} (chunkChars=${chunkChars ?? 'default'})`, () => {
+        expect(serializeJsonChunks(value, { chunkChars }).join('')).toBe(JSON.stringify(value));
+      });
+    }
+  }
+
+  it('returns no chunks for undefined, functions and symbols', () => {
+    expect(serializeJsonChunks(undefined)).toEqual([]);
+    expect(serializeJsonChunks(() => 1)).toEqual([]);
+    expect(serializeJsonChunks(Symbol('s'))).toEqual([]);
+  });
+
+  it('throws TypeError on cycles and BigInt', () => {
+    const cyclic: Record<string, unknown> = {};
+    cyclic['self'] = cyclic;
+    expect(() => serializeJsonChunks(cyclic)).toThrow(TypeError);
+    expect(() => serializeJsonChunks({ n: BigInt(1) })).toThrow(TypeError);
+  });
+
+  it('allows shared (non-cyclic) references', () => {
+    const shared = { a: 1 };
+    const value = { x: shared, y: shared };
+    expect(serializeJsonChunks(value).join('')).toBe(JSON.stringify(value));
+  });
+
+  it('builds the same envelope as the double stringify', () => {
+    const inner = serializeJsonChunks(fixtures['escapes'], { chunkChars: 5 });
+    expect(buildPlainEnvelopeChunks(inner).join('')).toBe(
+      JSON.stringify({ encrypted: false, data: JSON.stringify(fixtures['escapes']) }),
+    );
+  });
+
+  it('keeps chunks small for a 19k-message history with a huge tool output', () => {
+    const chunkChars = 1 << 20;
+    const state = {
+      conversationHistory: Array.from({ length: 19000 }, (_, i) => ({ id: i, content: `message ${i} "q"` })),
+      big: 'x\n'.repeat(2_500_000),
+    };
+    const spy = vi.spyOn(JSON, 'stringify');
+    const chunks = serializeJsonChunks(state, { chunkChars });
+    const wholeCalls = spy.mock.calls.filter(([arg]) => arg === state || arg === state.conversationHistory);
+    spy.mockRestore();
+    expect(wholeCalls).toHaveLength(0);
+    expect(Math.max(...chunks.map((c) => c.length))).toBeLessThanOrEqual(2 * chunkChars);
+    const envelope = buildPlainEnvelopeChunks(chunks);
+    expect(Math.max(...envelope.map((c) => c.length))).toBeLessThanOrEqual(6 * chunkChars);
+    expect(chunkedLength(chunks)).toBe(JSON.stringify(state).length);
+  });
+});
