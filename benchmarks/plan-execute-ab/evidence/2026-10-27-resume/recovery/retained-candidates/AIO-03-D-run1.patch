+/**
+ * Chunked JSON serialization for continuity payloads.
+ *
+ * A single `JSON.stringify` over a very large session (tens of thousands of
+ * messages) plus the second, escaped copy made for the on-disk envelope can
+ * exceed V8's allocation limits and abort the process. These helpers produce
+ * output identical to `JSON.stringify`, but as many ~1 MiB chunks.
+ */
+
+export const DEFAULT_CONTINUITY_CHUNK_CHARS = 1 << 20;
+
+export class ContinuityPayloadTooLargeError extends Error {
+  constructor(public readonly chars: number, public readonly limit: number) {
+    super(`Continuity payload of ${chars} characters exceeds the ${limit} character limit`);
+    this.name = 'ContinuityPayloadTooLargeError';
+  }
+}
+
+export interface SerializeJsonChunksOptions {
+  chunkChars?: number;
+}
+
+export function chunkedLength(chunks: readonly string[]): number {
+  let total = 0;
+  for (const chunk of chunks) total += chunk.length;
+  return total;
+}
+
+function isHighSurrogate(code: number): boolean {
+  return code >= 0xd800 && code <= 0xdbff;
+}
+
+function isLowSurrogate(code: number): boolean {
+  return code >= 0xdc00 && code <= 0xdfff;
+}
+
+/** Walks `value` synchronously, producing the same text as `JSON.stringify(value)` in chunks. */
+export function serializeJsonChunks(
+  value: unknown,
+  options: SerializeJsonChunksOptions = {},
+): string[] {
+  const chunkChars = Math.max(1, options.chunkChars ?? DEFAULT_CONTINUITY_CHUNK_CHARS);
+  const out: string[] = [];
+  let parts: string[] = [];
+  let buffered = 0;
+  const active = new Set<object>();
+
+  const push = (text: string): void => {
+    parts.push(text);
+    buffered += text.length;
+    if (buffered >= chunkChars) flush();
+  };
+  const flush = (): void => {
+    if (parts.length === 0) return;
+    out.push(parts.join(''));
+    parts = [];
+    buffered = 0;
+  };
+
+  const pushString = (str: string): void => {
+    if (str.length <= chunkChars) {
+      push(JSON.stringify(str));
+      return;
+    }
+    push('"');
+    flush();
+    let start = 0;
+    while (start < str.length) {
+      let end = Math.min(start + chunkChars, str.length);
+      if (
+        end < str.length
+        && isHighSurrogate(str.charCodeAt(end - 1))
+        && isLowSurrogate(str.charCodeAt(end))
+      ) {
+        end = end - 1 > start ? end - 1 : end + 1;
+      }
+      push(JSON.stringify(str.slice(start, end)).slice(1, -1));
+      flush();
+      start = end;
+    }
+    push('"');
+  };
+
+  const resolve = (v: unknown, key: string): unknown => {
+    if (v !== null && typeof v === 'object') {
+      const toJSON = (v as { toJSON?: unknown }).toJSON;
+      if (typeof toJSON === 'function') return toJSON.call(v, key);
+    }
+    return v;
+  };
+
+  const isOmitted = (v: unknown): boolean =>
+    v === undefined || typeof v === 'function' || typeof v === 'symbol';
+
+  const write = (v: unknown): void => {
+    if (typeof v === 'string') {
+      pushString(v);
+      return;
+    }
+    if (v === null || typeof v !== 'object') {
+      push(JSON.stringify(v)); // number, boolean, null; bigint throws TypeError
+      return;
+    }
+    if (
+      v instanceof Number || v instanceof String
+      || v instanceof Boolean || v instanceof BigInt
+    ) {
+      if (v instanceof String) pushString(String(v));
+      else push(JSON.stringify(v));
+      return;
+    }
+    if (active.has(v)) throw new TypeError('Converting circular structure to JSON');
+    active.add(v);
+    try {
+      if (Array.isArray(v)) {
+        push('[');
+        for (let i = 0; i < v.length; i++) {
+          if (i > 0) push(',');
+          const item = resolve(v[i], String(i));
+          if (isOmitted(item)) push('null');
+          else write(item);
+        }
+        push(']');
+      } else {
+        push('{');
+        let first = true;
+        const record = v as Record<string, unknown>;
+        for (const key of Object.keys(record)) {
+          const item = resolve(record[key], key);
+          if (isOmitted(item)) continue;
+          if (!first) push(',');
+          first = false;
+          push(JSON.stringify(key));
+          push(':');
+          write(item);
+        }
+        push('}');
+      }
+    } finally {
+      active.delete(v);
+    }
+  };
+
+  const root = resolve(value, '');
+  if (isOmitted(root)) return [];
+  write(root);
+  flush();
+  return out;
+}
+
+/** Chunks equal to `JSON.stringify({ encrypted: false, data: <inner joined> })`. */
+export function buildPlainEnvelopeChunks(inner: readonly string[]): string[] {
+  return [
+    '{"encrypted":false,"data":"',
+    ...inner.map((chunk) => JSON.stringify(chunk).slice(1, -1)),
+    '"}',
+  ];
+}
