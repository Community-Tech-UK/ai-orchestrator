index 0000000..6ed078c
--- /dev/null
+++ b/src/main/history/history-archive-merge.ts
@@ -0,0 +1,157 @@
+import type { ConversationData } from '../../shared/types/history.types';
+import { inferConversationHistoryProvider } from '../../shared/types/history.types';
+import type { Instance, OutputMessage } from '../../shared/types/instance.types';
+
+type ArchiveMergeInstance = Pick<
+  Instance,
+  'provider' | 'sessionId' | 'providerSessionId' | 'metadata' | 'status' | 'supersededBy'
+>;
+
+// Same lookup order as continuity-message-projection.ts.
+const TOOL_CALL_ID_KEYS = ['id', 'toolUseId', 'tool_use_id', 'toolCallId'] as const;
+const TOOL_RESULT_FOR_KEYS = ['tool_use_id', 'toolUseId', 'toolCallId', 'id'] as const;
+const OUTPUT_MESSAGE_TYPES = {
+  assistant: true, user: true, system: true, tool_use: true, tool_result: true, tool_outcome: true, error: true,
+} satisfies Record<OutputMessage['type'], true>;
+
+/**
+ * Fold the messages a previous archive of the same thread holds, and the new
+ * transcript no longer does, back into that transcript.
+ *
+ * A re-archived generation does not always carry the whole conversation: a
+ * crash revival or history restore rebuilds its buffer from a bounded window,
+ * and replacing the earlier, fuller archive with it deleted the rest of the
+ * thread from history for good. Archives that cannot be read, or that belong
+ * to a different runtime generation, contribute nothing — the latter is
+ * replaced outright, as before.
+ */
+export function mergeWithPreviousArchives(
+  current: OutputMessage[],
+  instance: ArchiveMergeInstance,
+  threadKey: string,
+  previousArchives: readonly (ConversationData | null)[],
+): OutputMessage[] {
+  let merged = current;
+  for (const previous of previousArchives) {
+    if (!previous || !Array.isArray(previous.messages)) continue;
+    if (!isLinkedArchive(previous, instance, threadKey)) continue;
+    merged = mergeArchiveTranscripts(previous.messages.filter(isValidMessage), merged);
+  }
+  return merged;
+}
+
+/**
+ * Previous-archive messages missing from `current`, merged in time order.
+ *
+ * `current` wins wherever both hold a message. A shared id and timestamp is
+ * the same message; the rest pair one-to-one by content identity, because a
+ * hibernate/wake or revival renumbers ids positionally — so one id can also
+ * name two different messages — and the same message reaches here under a new
+ * id. Pairing (rather than set membership), with the tool call id in the
+ * identity, keeps parallel tool calls from collapsing into one another.
+ */
+export function mergeArchiveTranscripts(
+  previous: readonly OutputMessage[],
+  current: OutputMessage[],
+): OutputMessage[] {
+  const currentIds = new Set(current.map(sameMessageKey));
+  const previousIds = new Set(previous.map(sameMessageKey));
+  const unpairedCurrent = new Map<string, number>();
+  for (const message of current) {
+    if (previousIds.has(sameMessageKey(message))) continue;
+    const key = renumberedIdentity(message);
+    unpairedCurrent.set(key, (unpairedCurrent.get(key) ?? 0) + 1);
+  }
+
+  const survivors: OutputMessage[] = [];
+  for (const message of previous) {
+    if (currentIds.has(sameMessageKey(message))) continue;
+    const key = renumberedIdentity(message);
+    const unpaired = unpairedCurrent.get(key) ?? 0;
+    if (unpaired > 0) {
+      unpairedCurrent.set(key, unpaired - 1);
+      continue;
+    }
+    survivors.push(message);
+  }
+  if (survivors.length === 0) return current;
+
+  // Stable sort: on equal timestamps the older archive's message comes first.
+  return [...survivors, ...current].sort((a, b) => a.timestamp - b.timestamp);
+}
+
+/**
+ * Whether a previous archive is an earlier view of this same runtime lineage.
+ *
+ * The provider session is the generation marker. A continuity revival that
+ * replays onto a fresh session is linked instead to the archive it was rebuilt
+ * from — its source runtime's, or the history entry it restored — and never to
+ * an unrelated archive of the thread, such as the pre-edit source of a fork. A
+ * superseded revival loses even that link: a fork now owns the thread and its
+ * archive must not be absorbed back into the source's.
+ */
+function isSameRuntimeGeneration(
+  previous: ConversationData,
+  instance: ArchiveMergeInstance,
+  threadKey: string,
+): boolean {
+  const entry = previous.entry;
+  if (!entry || typeof entry !== 'object' || trimmed(entry.historyThreadId) !== threadKey) return false;
+  if (inferConversationHistoryProvider(entry) !== instance.provider) return false;
+  const superseded = instance.status === 'superseded' || Boolean(instance.supersededBy);
+  if (instance.metadata?.['continuityRevival'] === true && !superseded && (
+    sameId(entry.id, instance.metadata['revivedFromHistoryEntryId'])
+    || sameId(entry.originalInstanceId, instance.metadata['sourceInstanceId'])
+  )) return true;
+
+  return [instance.sessionId, instance.providerSessionId].some((id) => sameId(entry.sessionId, id));
+}
+
+/** Parsed from disk without validation, so any malformed field reads as unrelated. */
+function isLinkedArchive(previous: ConversationData, instance: ArchiveMergeInstance, threadKey: string): boolean {
+  try {
+    return isSameRuntimeGeneration(previous, instance, threadKey);
+  } catch {
+    return false;
+  }
+}
+
+function trimmed(value: unknown): string | undefined {
+  return typeof value === 'string' ? value.trim() || undefined : undefined;
+}
+
+function sameId(left: unknown, right: unknown): boolean {
+  const id = trimmed(left);
+  return id !== undefined && id === trimmed(right);
+}
+
+function sameMessageKey(message: OutputMessage): string {
+  return `${message.id}\u0000${message.timestamp}`;
+}
+
+/**
+ * Identity that survives renumbering and the continuity projection a revival
+ * round-trips messages through: that projection folds error and system
+ * messages into one role and may move a tool call id between metadata keys.
+ */
+function renumberedIdentity(message: OutputMessage): string {
+  const kind = message.type === 'user' || message.type === 'assistant'
+    || message.type === 'tool_use' || message.type === 'tool_result'
+    ? message.type
+    : 'system';
+  const callIdKeys = message.type === 'tool_result' ? TOOL_RESULT_FOR_KEYS : TOOL_CALL_ID_KEYS;
+  const callId = message.type === 'tool_use' || message.type === 'tool_result'
+    ? callIdKeys.map((key) => trimmed(message.metadata?.[key])).find(Boolean) ?? ''
+    : '';
+  return [kind, message.timestamp, callId, message.content].join('\u0000');
+}
+
+function isValidMessage(message: OutputMessage): boolean {
+  return Boolean(
+    message
+    && typeof message.id === 'string'
+    && typeof message.content === 'string'
+    && Number.isFinite(message.timestamp)
+    && Object.hasOwn(OUTPUT_MESSAGE_TYPES, message.type)
+  );
+}
