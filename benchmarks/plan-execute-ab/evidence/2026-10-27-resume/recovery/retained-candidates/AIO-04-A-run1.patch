+import { describe, expect, it } from 'vitest';
+import type { ConversationData, ConversationHistoryEntry } from '../../shared/types/history.types';
+import type { OutputMessage } from '../../shared/types/instance.types';
+import { mergeArchiveTranscripts, mergeWithPreviousArchives } from './history-archive-merge';
+
+function message(
+  id: string,
+  type: OutputMessage['type'],
+  content: string,
+  timestamp: number,
+  metadata?: Record<string, unknown>,
+): OutputMessage {
+  return { id, type, content, timestamp, ...(metadata ? { metadata } : {}) };
+}
+
+function archive(messages: OutputMessage[], overrides: Partial<ConversationHistoryEntry> = {}): ConversationData {
+  return {
+    entry: {
+      id: 'entry-merge',
+      displayName: 'Merge fixture',
+      createdAt: 1,
+      endedAt: 1_000,
+      historyThreadId: 'thread-merge',
+      workingDirectory: '/tmp/merge',
+      messageCount: messages.length,
+      firstUserMessage: 'first',
+      lastUserMessage: 'last',
+      status: 'completed',
+      originalInstanceId: 'instance-before-crash',
+      parentId: null,
+      sessionId: 'session-shared',
+      provider: 'claude',
+      currentModel: 'opus',
+      ...overrides,
+    },
+    messages,
+  };
+}
+
+const sameGeneration = {
+  provider: 'claude' as const, status: 'idle' as const, sessionId: 'session-shared', providerSessionId: 'session-shared',
+};
+
+describe('mergeArchiveTranscripts', () => {
+  it('keeps old-only messages in time order', () => {
+    const merged = mergeArchiveTranscripts(
+      [message('u1', 'user', 'open', 10), message('a1', 'assistant', 'answer', 20), message('u2', 'user', 'next', 30)],
+      [message('u2', 'user', 'next', 30), message('a2', 'assistant', 'reply', 40)],
+    );
+    expect(merged.map((item) => item.id)).toEqual(['u1', 'a1', 'u2', 'a2']);
+  });
+
+  it('lets the newer transcript win for a shared id', () => {
+    const merged = mergeArchiveTranscripts(
+      [message('a1', 'assistant', 'partial', 20)],
+      [message('a1', 'assistant', 'complete', 20)],
+    );
+    expect(merged).toEqual([message('a1', 'assistant', 'complete', 20)]);
+  });
+
+  it('does not double-count a renumbered duplicate', () => {
+    const merged = mergeArchiveTranscripts(
+      [message('msg-0', 'user', 'open', 10), message('msg-1', 'assistant', 'answer', 20)],
+      [message('continuity-msg-0', 'user', 'open', 10), message('continuity-msg-1', 'assistant', 'answer', 20)],
+    );
+    expect(merged.map((item) => item.id)).toEqual(['continuity-msg-0', 'continuity-msg-1']);
+  });
+
+  it('preserves parallel tool calls that share a timestamp and content', () => {
+    const merged = mergeArchiveTranscripts(
+      [message('t1', 'tool_use', 'Using tool', 50), message('t2', 'tool_use', 'Using tool', 50)],
+      [message('u9', 'user', 'later', 90)],
+    );
+    expect(merged.map((item) => item.id)).toEqual(['t1', 't2', 'u9']);
+
+    const partlyRenumbered = mergeArchiveTranscripts(
+      [message('t1', 'tool_use', 'Using tool', 50), message('t2', 'tool_use', 'Using tool', 50)],
+      [message('r1', 'tool_use', 'Using tool', 50)],
+    );
+    expect(partlyRenumbered).toHaveLength(2);
+  });
+  it('keeps both messages when a renumbered id now names a different message', () => {
+    const merged = mergeArchiveTranscripts(
+      [message('msg-0', 'user', 'open', 10), message('msg-1', 'assistant', 'answer', 20)],
+      [message('msg-0', 'user', 'follow-up', 300), message('msg-1', 'assistant', 'reply', 310)],
+    );
+    expect(merged.map((item) => item.content)).toEqual(['open', 'answer', 'follow-up', 'reply']);
+  });
+
+  it('pairs a renumbered parallel tool call by its call id', () => {
+    const merged = mergeArchiveTranscripts(
+      [
+        message('t1', 'tool_use', 'Using tool', 50, { id: 'call-A' }),
+        message('t2', 'tool_use', 'Using tool', 50, { toolUseId: 'call-B' }),
+      ],
+      [message('continuity-t2', 'tool_use', 'Using tool', 50, { id: 'call-B' })],
+    );
+    expect(merged.map((item) => item.id)).toEqual(['t1', 'continuity-t2']);
+  });
+
+  it('does not pair messages of different kinds that share a timestamp and content', () => {
+    const merged = mergeArchiveTranscripts(
+      [message('a1', 'assistant', 'ok', 60)],
+      [message('r1', 'tool_result', 'ok', 60)],
+    );
+    expect(merged.map((item) => item.id)).toEqual(['a1', 'r1']);
+  });
+
+  it('pairs an error renumbered into a system message by the continuity projection', () => {
+    const merged = mergeArchiveTranscripts(
+      [message('e1', 'error', 'boom', 70)],
+      [message('continuity-e1', 'system', 'boom', 70)],
+    );
+    expect(merged.map((item) => item.id)).toEqual(['continuity-e1']);
+  });
+});
+
+describe('mergeWithPreviousArchives', () => {
+  const current = [message('u3', 'user', 'after revival', 300)];
+
+  it('restores messages only the earlier archive of the same generation holds', () => {
+    const merged = mergeWithPreviousArchives(current, sameGeneration, 'thread-merge', [
+      archive([message('u1', 'user', 'open', 100), message('a1', 'assistant', 'answer', 200)]),
+    ]);
+    expect(merged.map((item) => item.id)).toEqual(['u1', 'a1', 'u3']);
+  });
+
+  it('treats a continuity revival on a fresh session as the same lineage', () => {
+    const merged = mergeWithPreviousArchives(
+      current,
+      {
+        ...sameGeneration, sessionId: 'fresh', providerSessionId: 'fresh',
+        metadata: { continuityRevival: true, revivedFromHistoryEntryId: 'entry-merge' },
+      },
+      'thread-merge',
+      [archive([message('u1', 'user', 'open', 100)])],
+    );
+    expect(merged.map((item) => item.id)).toEqual(['u1', 'u3']);
+  });
+
+  it('does not let a revival absorb an archive it was not rebuilt from', () => {
+    const merged = mergeWithPreviousArchives(
+      current,
+      {
+        ...sameGeneration, sessionId: 'fresh', providerSessionId: 'fresh',
+        metadata: { continuityRevival: true, sourceInstanceId: 'fork-1' },
+      },
+      'thread-merge',
+      [archive([message('pre-edit', 'user', 'replaced ask', 100)], {
+        originalInstanceId: 'superseded-source', sessionId: 'source-session',
+      })],
+    );
+    expect(merged).toBe(current);
+  });
+
+  it('does not let a superseded revival absorb the archive of the fork that replaced it', () => {
+    const merged = mergeWithPreviousArchives(
+      current,
+      {
+        ...sameGeneration, status: 'superseded', supersededBy: 'fork-1',
+        sessionId: 'fresh', providerSessionId: 'fresh',
+        metadata: { continuityRevival: true, sourceInstanceId: 'instance-before-crash' },
+      },
+      'thread-merge',
+      [archive([message('fork-u1', 'user', 'edited ask', 100)], { sessionId: 'fork-session' })],
+    );
+    expect(merged).toBe(current);
+  });
+
+  it('ignores missing, unreadable, and malformed previous archives', () => {
+    const malformed = { entry: archive([]).entry, messages: 'not-an-array' } as unknown as ConversationData;
+    const partlyCorrupt = archive([
+      { id: 'bad', type: 'user', content: 7, timestamp: 1 } as unknown as OutputMessage,
+      message('u1', 'user', 'open', 100),
+    ]);
+    const merged = mergeWithPreviousArchives(current, sameGeneration, 'thread-merge', [null, malformed, partlyCorrupt]);
+    expect(merged.map((item) => item.id)).toEqual(['u1', 'u3']);
+  });
+
+  it.each([
+    ['session', { sessionId: 'session-other-generation' }],
+    ['thread', { historyThreadId: 'thread-other' }],
+    ['provider', { provider: 'codex' as const }],
+  ])('replaces an archive from a different %s outright', (_label, overrides) => {
+    const merged = mergeWithPreviousArchives(current, sameGeneration, 'thread-merge', [
+      archive([message('u1', 'user', 'open', 100)], overrides),
+    ]);
+    expect(merged).toBe(current);
+  });
+
+  it('ignores a parseable archive with malformed identity fields', () => {
+    const malformed = archive([message('u1', 'user', 'open', 100)]);
+    (malformed.entry as unknown as Record<string, unknown>)['historyThreadId'] = 42;
+    (malformed.entry as unknown as Record<string, unknown>)['sessionId'] = 7;
+    expect(mergeWithPreviousArchives(current, sameGeneration, 'thread-merge', [malformed])).toBe(current);
+  });
+
+  it('ignores an archive whose provider cannot be inferred from malformed fields', () => {
+    const malformed = archive([message('u1', 'user', 'open', 100)]);
+    const entry = malformed.entry as unknown as Record<string, unknown>;
+    delete entry['provider'];
+    entry['sessionId'] = 7;
+    entry['currentModel'] = 5;
+    expect(mergeWithPreviousArchives(current, sameGeneration, 'thread-merge', [malformed])).toBe(current);
+  });
+
+  it('does not link a revival to an archive with no recorded source', () => {
+    const legacy = archive([message('u1', 'user', 'open', 100)], { sessionId: 'other-session' });
+    delete (legacy.entry as Partial<ConversationHistoryEntry>).originalInstanceId;
+    const merged = mergeWithPreviousArchives(
+      current,
+      { ...sameGeneration, sessionId: 'fresh', providerSessionId: 'fresh', metadata: { continuityRevival: true } },
+      'thread-merge',
+      [legacy],
+    );
+    expect(merged).toBe(current);
+  });
+});
