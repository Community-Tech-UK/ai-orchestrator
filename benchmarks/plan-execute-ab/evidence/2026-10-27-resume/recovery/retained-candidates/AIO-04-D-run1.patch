+import { describe, expect, it } from 'vitest';
+import type { OutputMessage } from '../../shared/types/instance.types';
+import type { ConversationData } from '../../shared/types/history.types';
+import { canMergePreviousArchive, mergeArchiveTranscripts } from './archive-transcript-merge';
+
+function msg(
+  id: string,
+  type: OutputMessage['type'],
+  content: string,
+  timestamp: number,
+  metadata?: Record<string, unknown>,
+): OutputMessage {
+  return { id, type, content, timestamp, metadata };
+}
+
+describe('mergeArchiveTranscripts', () => {
+  it('keeps old-only messages interleaved by timestamp', () => {
+    const result = mergeArchiveTranscripts(
+      [msg('a', 'user', 'one', 1000), msg('b', 'assistant', 'two', 20000)],
+      [msg('c', 'user', 'three', 10000)],
+    );
+    expect(result.messages.map((m) => m.id)).toEqual(['a', 'c', 'b']);
+    expect(result.preservedCount).toBe(2);
+  });
+
+  it('prefers the newer copy when ids match', () => {
+    const result = mergeArchiveTranscripts(
+      [msg('a', 'user', 'old', 1000)],
+      [msg('a', 'user', 'new', 1000)],
+    );
+    expect(result.messages).toHaveLength(1);
+    expect(result.messages[0]!.content).toBe('new');
+  });
+
+  it('drops a renumbered duplicate once', () => {
+    const result = mergeArchiveTranscripts(
+      [msg('old-1', 'user', 'hello', 1000)],
+      [msg('restored-prompt-msg-1', 'user', 'hello', 1500)],
+    );
+    expect(result.messages.map((m) => m.id)).toEqual(['restored-prompt-msg-1']);
+    expect(result.droppedDuplicates).toBe(1);
+  });
+
+  it('keeps parallel tool calls and results', () => {
+    const calls = [
+      msg('t1', 'tool_use', 'Read', 1000, { toolUseId: 'c1', name: 'Read' }),
+      msg('t2', 'tool_use', 'Read', 1000, { toolUseId: 'c2', name: 'Read' }),
+      msg('r1', 'tool_result', 'x', 1001, { toolUseId: 'c1' }),
+      msg('r2', 'tool_result', 'y', 1001, { toolUseId: 'c2' }),
+    ];
+    const result = mergeArchiveTranscripts(calls, [msg('u', 'user', 'later', 900000)]);
+    expect(result.messages).toHaveLength(5);
+  });
+
+  it('matches duplicates one-for-one', () => {
+    const result = mergeArchiveTranscripts(
+      [msg('x1', 'assistant', 'same', 1000), msg('x2', 'assistant', 'same', 1000)],
+      [msg('y1', 'assistant', 'same', 1000)],
+    );
+    expect(result.messages.map((m) => m.id)).toEqual(['x2', 'y1']);
+  });
+
+  it('does not mutate inputs and skips malformed old messages', () => {
+    const previous = [
+      msg('a', 'user', 'one', 1000),
+      { id: 5, type: 'user', content: 'bad', timestamp: 1 } as unknown as OutputMessage,
+      { id: 'nots', type: 'user', content: 'bad', timestamp: Number.NaN } as OutputMessage,
+    ];
+    const current = [msg('b', 'user', 'two', 2000)];
+    const before = JSON.stringify([previous, current]);
+    const result = mergeArchiveTranscripts(previous, current);
+    expect(result.messages.map((m) => m.id)).toEqual(['a', 'b']);
+    expect(JSON.stringify([previous, current])).toBe(before);
+  });
+});
+
+describe('canMergePreviousArchive', () => {
+  const persisted = (overrides: Partial<ConversationData['entry']> = {}): ConversationData => ({
+    entry: { historyThreadId: 't', ...overrides } as ConversationData['entry'],
+    messages: [],
+  });
+  const base = { instance: {} as never, threadKey: 't', indexEntry: {}, persisted: persisted() };
+
+  it('merges matching lineage', () => {
+    expect(canMergePreviousArchive(base).merge).toBe(true);
+  });
+
+  it.each([
+    ['null persisted', { persisted: null }],
+    ['thread mismatch', { persisted: persisted({ historyThreadId: 'other' }) }],
+    ['superseded instance', { instance: { supersededBy: 'f' } as never }],
+    ['superseded index entry', { indexEntry: { supersededBy: 'f' } }],
+    ['superseded persisted entry', { persisted: persisted({ supersededBy: 'f' }) }],
+    [
+      'original is the superseding id',
+      { instance: { supersededBy: 'f' } as never, indexEntry: { originalInstanceId: 'f' } },
+    ],
+  ])('replaces outright: %s', (_name, overrides) => {
+    expect(canMergePreviousArchive({ ...base, ...overrides }).merge).toBe(false);
+  });
+});
