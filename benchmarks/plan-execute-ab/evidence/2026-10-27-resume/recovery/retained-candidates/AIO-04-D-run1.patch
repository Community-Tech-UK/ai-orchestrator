index 0000000..49245d5
--- /dev/null
+++ b/src/main/history/archive-transcript-merge.ts
@@ -0,0 +1,145 @@
+/**
+ * Merges a previous archive's transcript with a newly archived one so a
+ * trimmed crash-revival cannot erase messages only the earlier archive held.
+ */
+
+import type { OutputMessage, Instance } from '../../shared/types/instance.types';
+import type { ConversationData, ConversationHistoryEntry } from '../../shared/types/history.types';
+import { outputMessagesToContinuityEntries } from '../session/continuity-message-projection';
+import { getLogger } from '../logging/logger';
+import { redactArchiveIdentifier } from './should-archive-instance';
+import { recoveryFingerprint } from '../session/recovery-transcript-reconciler';
+
+export interface ArchiveMergeResult {
+  messages: OutputMessage[];
+  preservedCount: number;
+  droppedDuplicates: number;
+}
+
+function timestampOf(message: OutputMessage): number {
+  return Number.isFinite(message.timestamp) ? message.timestamp : 0;
+}
+
+function isWellFormed(message: unknown): message is OutputMessage {
+  if (!message || typeof message !== 'object') return false;
+  const candidate = message as Partial<OutputMessage>;
+  return typeof candidate.id === 'string' && Number.isFinite(candidate.timestamp);
+}
+
+function fingerprints(messages: readonly OutputMessage[]): string[] {
+  return outputMessagesToContinuityEntries(messages).map(recoveryFingerprint);
+}
+
+/**
+ * Messages only the previous archive holds survive; where both hold the same
+ * id the current copy wins; a renumbered duplicate (same fingerprint, new id)
+ * is dropped one-for-one so repeated messages keep their multiplicity.
+ */
+export function mergeArchiveTranscripts(
+  previous: readonly OutputMessage[],
+  current: readonly OutputMessage[],
+): ArchiveMergeResult {
+  const validPrevious = previous.filter(isWellFormed);
+  const previousIds = new Set(validPrevious.map((message) => message.id));
+  const currentIds = new Set(current.map((message) => message.id));
+
+  const available = new Map<string, number>();
+  const currentPrints = fingerprints(current);
+  current.forEach((message, index) => {
+    if (previousIds.has(message.id)) return;
+    const print = currentPrints[index]!;
+    available.set(print, (available.get(print) ?? 0) + 1);
+  });
+
+  const previousPrints = fingerprints(validPrevious);
+  const kept: OutputMessage[] = [];
+  let droppedDuplicates = 0;
+  validPrevious.forEach((message, index) => {
+    if (currentIds.has(message.id)) return;
+    const print = previousPrints[index]!;
+    const remaining = available.get(print) ?? 0;
+    if (remaining > 0) {
+      available.set(print, remaining - 1);
+      droppedDuplicates++;
+      return;
+    }
+    kept.push(message);
+  });
+
+  const messages = [...kept, ...current].sort((a, b) => timestampOf(a) - timestampOf(b));
+  return { messages, preservedCount: kept.length, droppedDuplicates };
+}
+
+export interface CanMergeInput {
+  instance: Pick<Instance, 'supersededBy' | 'status'>;
+  threadKey: string;
+  indexEntry: { supersededBy?: string; originalInstanceId?: string };
+  persisted: ConversationData | null;
+}
+
+/** Replace outright when the previous archive is from a different runtime generation. */
+export function canMergePreviousArchive(
+  input: CanMergeInput,
+): { merge: boolean; reason: string } {
+  const { instance, threadKey, indexEntry, persisted } = input;
+  if (!persisted || !Array.isArray(persisted.messages)) {
+    return { merge: false, reason: 'previous archive unreadable' };
+  }
+  if (persisted.entry?.historyThreadId?.trim() !== threadKey) {
+    return { merge: false, reason: 'thread mismatch' };
+  }
+  if (instance.supersededBy || (instance.status as string) === 'superseded') {
+    return { merge: false, reason: 'instance superseded' };
+  }
+  if (
+    indexEntry.supersededBy
+    || persisted.entry.supersededBy
+    || (instance.supersededBy !== undefined
+      && indexEntry.originalInstanceId === instance.supersededBy)
+  ) {
+    return { merge: false, reason: 'previous archive from superseded source' };
+  }
+  return { merge: true, reason: 'same lineage' };
+}
+
+const logger = getLogger('HistoryManager');
+
+/** Fold every earlier archive of a thread into the new transcript; unreadable ones are ignored. */
+export async function mergeWithPreviousArchives(args: {
+  instance: Instance;
+  threadKey: string;
+  previousEntries: readonly ConversationHistoryEntry[];
+  currentMessages: OutputMessage[];
+  load: (entryId: string) => Promise<ConversationData | null>;
+}): Promise<OutputMessage[]> {
+  let messages = args.currentMessages;
+  for (const previousEntry of args.previousEntries) {
+    let persisted: ConversationData | null = null;
+    try {
+      persisted = await args.load(previousEntry.id);
+    } catch {
+      persisted = null;
+    }
+    const verdict = canMergePreviousArchive({
+      instance: args.instance,
+      threadKey: args.threadKey,
+      indexEntry: previousEntry,
+      persisted,
+    });
+    if (!verdict.merge || !persisted) {
+      logger.info('Replacing previous archive outright', {
+        entryId: redactArchiveIdentifier(previousEntry.id),
+        reason: verdict.reason,
+      });
+      continue;
+    }
+    const merged = mergeArchiveTranscripts(persisted.messages, messages);
+    logger.info('Merged previous archive', {
+      entryId: redactArchiveIdentifier(previousEntry.id),
+      preserved: merged.preservedCount,
+      droppedDuplicates: merged.droppedDuplicates,
+    });
+    messages = merged.messages;
+  }
+  return messages;
+}
