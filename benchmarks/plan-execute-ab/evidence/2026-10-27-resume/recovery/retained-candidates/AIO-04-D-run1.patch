+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Instance, OutputMessage } from '../../shared/types/instance.types';
+
+vi.mock('../logging/logger', () => ({
+  getLogger: () => ({ info: vi.fn(), warn: vi.fn(), error: vi.fn(), debug: vi.fn() }),
+}));
+
+function makeInstance(overrides: Partial<Instance> = {}): Instance {
+  return {
+    id: 'instance-1',
+    displayName: 'Thread',
+    createdAt: 100,
+    historyThreadId: 'thread-1',
+    parentId: null,
+    childrenIds: [],
+    supervisorNodeId: '',
+    depth: 0,
+    terminationPolicy: 'terminate-children',
+    launchMode: 'orchestrated',
+    executionLocation: { type: 'local' },
+    contextInheritance: {} as Instance['contextInheritance'],
+    agentId: 'build',
+    agentMode: 'build',
+    planMode: { enabled: false, state: 'off' },
+    status: 'idle',
+    contextUsage: { used: 0, total: 200000, percentage: 0 },
+    lastActivity: 200,
+    processId: null,
+    providerSessionId: 'session-1',
+    sessionId: 'session-1',
+    restartEpoch: 0,
+    workingDirectory: '/tmp/project',
+    yoloMode: false,
+    provider: 'claude',
+    currentModel: 'opus',
+    outputBuffer: [],
+    outputBufferMaxSize: 1000,
+    communicationTokens: new Map(),
+    subscribedTo: [],
+    totalTokensUsed: 0,
+    requestCount: 0,
+    errorCount: 0,
+    restartCount: 0,
+    ...overrides,
+  };
+}
+
+function msg(
+  id: string,
+  type: OutputMessage['type'],
+  content: string,
+  timestamp: number,
+  metadata?: Record<string, unknown>,
+): OutputMessage {
+  return { id, type, content, timestamp, metadata };
+}
+
+const T = 1_000_000;
+const original = [
+  msg('m1', 'user', 'first prompt', T),
+  msg('m2', 'assistant', 'answer one', T + 10_000),
+  msg('m3', 'user', 'second prompt', T + 20_000),
+  msg('m4', 'assistant', 'answer two', T + 30_000),
+  msg('m5', 'user', 'third prompt', T + 40_000),
+  msg('m6', 'assistant', 'answer three', T + 50_000),
+];
+
+describe('HistoryManager re-archive merge', () => {
+  let userDataDir = '';
+  const pending: Promise<void>[] = [];
+
+  function track<M extends { startupTasks: Promise<void> }>(manager: M): M {
+    pending.push(manager.startupTasks);
+    return manager;
+  }
+
+  async function createManager() {
+    const { HistoryManager } = await import('./history-manager');
+    const manager = track(new HistoryManager());
+    await manager.startupTasks;
+    return manager;
+  }
+
+  const storageDir = () => path.join(userDataDir, 'conversation-history');
+  const gzFiles = () => fs.readdirSync(storageDir()).filter((f) => f.endsWith('.json.gz'));
+
+  beforeEach(() => {
+    vi.resetModules();
+    userDataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'history-merge-'));
+    vi.doMock('electron', () => ({
+      app: {
+        getPath: vi.fn((name: string) => {
+          if (name === 'userData') return userDataDir;
+          throw new Error(`Unexpected path lookup: ${name}`);
+        }),
+      },
+    }));
+  });
+
+  afterEach(async () => {
+    await Promise.allSettled(pending.splice(0));
+    vi.doUnmock('electron');
+    vi.resetModules();
+    fs.rmSync(userDataDir, { recursive: true, force: true });
+  });
+
+  it('keeps old-only messages when a trimmed crash revival is re-archived', async () => {
+    const manager = await createManager();
+    await manager.archiveInstance(makeInstance({ outputBuffer: original }), 'completed');
+    const entryId = manager.getEntries()[0]!.id;
+
+    const revival = makeInstance({
+      id: 'instance-2',
+      metadata: { continuityRevival: true },
+      outputBuffer: [
+        msg('r1', 'user', 'third prompt', T + 40_000),
+        msg('r2', 'assistant', 'answer three', T + 50_000),
+        msg('r3', 'user', 'fourth prompt', T + 60_000),
+        msg('r4', 'assistant', 'answer four', T + 70_000),
+      ],
+    });
+    await manager.archiveInstance(revival, 'completed');
+
+    const entries = manager.getEntries();
+    expect(entries).toHaveLength(1);
+    expect(entries[0]!.messageCount).toBe(8);
+    expect(entries[0]!.originalInstanceId).toBe('instance-2');
+    expect(gzFiles()).toHaveLength(1);
+    const conversation = await manager.loadConversation(entries[0]!.id);
+    expect(conversation?.messages.map((m) => m.content)).toEqual([
+      'first prompt', 'answer one', 'second prompt', 'answer two',
+      'third prompt', 'answer three', 'fourth prompt', 'answer four',
+    ]);
+    expect(entries[0]!.id).toBe(entryId);
+  });
+
+  it('stores the newer content when the same id is archived again', async () => {
+    const manager = await createManager();
+    await manager.archiveInstance(makeInstance({ outputBuffer: original }), 'completed');
+    await manager.archiveInstance(makeInstance({
+      id: 'instance-2',
+      outputBuffer: [msg('m6', 'assistant', 'edited answer', T + 50_000), msg('m7', 'user', 'more', T + 60_000)],
+    }), 'completed');
+    const conversation = await manager.loadConversation(manager.getEntries()[0]!.id);
+    expect(conversation?.messages).toHaveLength(7);
+    expect(conversation?.messages.find((m) => m.id === 'm6')?.content).toBe('edited answer');
+  });
+
+  it('does not double-count renumbered prompts', async () => {
+    const manager = await createManager();
+    await manager.archiveInstance(makeInstance({ outputBuffer: original }), 'completed');
+    await manager.archiveInstance(makeInstance({
+      id: 'instance-2',
+      outputBuffer: [
+        msg('restored-prompt-msg-0', 'user', 'first prompt', T),
+        msg('restored-prompt-msg-1', 'user', 'second prompt', T + 20_000),
+        msg('n1', 'assistant', 'fresh', T + 90_000),
+      ],
+    }), 'completed');
+    const entry = manager.getEntries()[0]!;
+    expect(entry.messageCount).toBe(7);
+    const conversation = await manager.loadConversation(entry.id);
+    expect(conversation?.messages.filter((m) => m.content === 'first prompt')).toHaveLength(1);
+  });
+
+  it('preserves parallel tool calls held only in the old archive', async () => {
+    const manager = await createManager();
+    await manager.archiveInstance(makeInstance({
+      outputBuffer: [
+        msg('t1', 'tool_use', 'Read', T, { toolUseId: 'c1', name: 'Read' }),
+        msg('t2', 'tool_use', 'Read', T, { toolUseId: 'c2', name: 'Read' }),
+        msg('tr1', 'tool_result', 'a', T + 1000, { toolUseId: 'c1' }),
+        msg('tr2', 'tool_result', 'b', T + 1000, { toolUseId: 'c2' }),
+      ],
+    }), 'completed');
+    await manager.archiveInstance(makeInstance({
+      id: 'instance-2',
+      outputBuffer: [msg('n1', 'user', 'later', T + 100_000)],
+    }), 'completed');
+    expect(manager.getEntries()[0]!.messageCount).toBe(5);
+  });
+
+  it('archives on its own when the old file is missing', async () => {
+    const manager = await createManager();
+    await manager.archiveInstance(makeInstance({ outputBuffer: original }), 'completed');
+    for (const f of gzFiles()) fs.unlinkSync(path.join(storageDir(), f));
+    await manager.archiveInstance(makeInstance({
+      id: 'instance-2',
+      outputBuffer: [msg('n1', 'user', 'only', T + 100_000), msg('n2', 'assistant', 'new', T + 110_000)],
+    }), 'completed');
+    expect(manager.getEntries()[0]!.messageCount).toBe(2);
+  });
+
+  it('archives on its own when the old file is corrupt', async () => {
+    const manager = await createManager();
+    await manager.archiveInstance(makeInstance({ outputBuffer: original }), 'completed');
+    for (const f of gzFiles()) fs.writeFileSync(path.join(storageDir(), f), 'garbage');
+    await expect(manager.archiveInstance(makeInstance({
+      id: 'instance-2',
+      outputBuffer: [msg('n1', 'user', 'only', T + 100_000), msg('n2', 'assistant', 'new', T + 110_000)],
+    }), 'completed')).resolves.toBeUndefined();
+    expect(manager.getEntries()[0]!.messageCount).toBe(2);
+  });
+
+  it('replaces a superseded source archive outright when a fork archives', async () => {
+    const manager = await createManager();
+    await manager.archiveInstance(makeInstance({
+      id: 'source',
+      status: 'superseded',
+      supersededBy: 'fork',
+      outputBuffer: original,
+    }), 'completed');
+    const forkMessages = [msg('f1', 'user', 'edited prompt', T + 100_000), msg('f2', 'assistant', 'fork reply', T + 110_000)];
+    await manager.archiveInstance(makeInstance({ id: 'fork', outputBuffer: forkMessages }), 'completed');
+    const conversation = await manager.loadConversation(manager.getEntries()[0]!.id);
+    expect(conversation?.messages.map((m) => m.id)).toEqual(['f1', 'f2']);
+  });
+});
