+/**
+ * Failure reason when a run that looked finished actually stopped on a
+ * provider usage/spend limit (its final output is the limit notice, or the
+ * session was parked on the limit); undefined for a genuine completion.
+ */
+export function getProviderLimitExitReason(tracking: RunTracking): string | undefined {
+  if (isProviderLimitExitNotice(tracking.lastAssistantOutput)) {
+    return `Provider limit reached: ${tracking.lastAssistantOutput!.trim().slice(0, 300)}`;
+  }
+  return tracking.providerLimitParked
+    ? 'Provider limit reached: the session was parked until the limit resets'
+    : undefined;
