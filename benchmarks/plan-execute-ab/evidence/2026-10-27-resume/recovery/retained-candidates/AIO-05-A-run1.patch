+  // "Add more caching" stay ordinary work.
+  String.raw`|(?:please\s+)?upgrade(?:\s+(?:to\s+(?:a\s+)?(?:pro|plus|max|team|business|enterprise|premium|paid|ultra|higher)|your\s+(?:plan|subscription|account)|now)\b|$)`,
+  String.raw`|(?:please\s+)?(?:raise|increase)\s+(?:it|your\s+(?:[\w-]+\s+){0,2}(?:limit|quota|cap|budget|spend\w*))\b`,
+  String.raw`|(?:please\s+)?(?:add|purchase|buy)\s+(?:more\s+)?(?:funds|credits|usage|quota|requests|a\s+payment)\b`,
+  String.raw`|(?:please\s+)?(?:visit|go\s+to|see)\s+(?:https?:|plans\s*(?:&|and)\s*billing|your\s+(?:billing|account|usage|plan|dashboard))`,
+  String.raw`|(?:please\s+)?check\s+your\s+(?:plan|billing|usage)(?:\s+(?:and|&)\s+billing)?(?:\s+details)?(?:\s+at\b.*)?$`,
+  String.raw`|enable\s+(?:usage-based\s+pricing|(?:extra|additional|overage)\s+usage)\b`,
+  String.raw`|for\s+more\s+information\b|head\s+to:?\s*https?:`, // Gemini 429 trailer
+  String.raw`|you(?:\s+will|'ll|’ll)\s+regain\s+access\b`,
+  String.raw`|you\s+can\s+(?:(?:try\s+again|retry)(?:\s+(?:at|in|after|on)\b.*|\s+later)?$|upgrade\s+(?:to|your)|purchase|buy|add\s+(?:funds|credits)|continue\s+(?:at|after|in|on|when))`,
+  String.raw`|your\s+(?:quota|limit|credits?|access|balance|spend\w*)\s+(?:will\s+(?:reset|renew)|is\s+(?:exhausted|empty|depleted))\b`,
+  String.raw`|to\s+(?:continue|keep\s+going|keep\s+using(?:\s+[\w-]+){0,2}|get\s+more(?:\s+[\w-]+){0,3})$`,
+  String.raw`|(?:please\s+)?(?:contact|ask|send\s+a\s+request\s+to)\s+your\s+(?:admin|administrator|organi[sz]ation|workspace\s+owner)\b`,
+  // URLs and slash commands ("/usage", "/upgrade") are only ever pointers in a notice.
+  String.raw`|learn\s+more(?:\s+at)?\s*(?:https?:|$)|request\s+id\s*[:#]|https?:\/\/|(?:run\s+)?\/[a-z-]+(?:\s+to\b.*)?$`,
+  String.raw`|-?\s*\[[\w\s:.-]+\]$`, // Codex "- [codex_error_info: usageLimitExceeded]"
+  String.raw`|\(.*\)$`, // "(Europe/London)", "(Request ID: …)"
+  String.raw`|\d+$|\d{4}\s+\d{1,2}(?::\d{2})?\s*[ap]\.?m\.?$`, // epoch after "|", "2026 9:37 PM" after a comma
+  String.raw`)`,
+].join(''), 'i');
+
+/**
+ * A follow-on clause that reports the model's own work ("I added", "now has",
+ * "the run passed", a CLI flag) is never notice detail, whatever it opens with.
+ */
+const PROVIDER_LIMIT_EXIT_WORK_REPORT_RE =
+  /\b(?:i|i've|i'm|we|we've|my|our|now\s+(?:has|is|works|passes|runs)|passed|fixed|added|updated|created|wrote|rewrote|ran|implemented|completed|finished|succeeded|pending|items?|files?|tests?|code)\b|(?:^|\s)--\w/i;
+
+/**
+ * True when an automation's final output *is* a provider usage/spend-limit
+ * notice, meaning the run stopped on the limit rather than finishing its task.
+ *
+ * Stricter than {@link isProviderNotice}: a misclassified run is recorded as
+ * failed, so ordinary output that merely mentions a reset time, quota wording
+ * or "too many requests" must not match. The message has to be notice-sized,
+ * open with a whole limit clause, and contain nothing but notice detail after.
+ */
+export function isProviderLimitExitNotice(text: string | null | undefined): boolean {
+  const trimmed = text?.trim();
+  if (!trimmed || trimmed.length > PROVIDER_LIMIT_EXIT_MAX_CHARS) return false;
+  const clauses = trimmed
+    .replace(/\*\*|__/g, '')
+    .replace(PROVIDER_LIMIT_EXIT_PREFIX_RE, '')
+    .split(PROVIDER_LIMIT_EXIT_CLAUSE_SPLIT_RE)
+    .map((clause) => clause.trim())
+    .filter((clause) => clause.length > 0);
+  const [head, ...details] = clauses;
+  if (!head || !PROVIDER_LIMIT_EXIT_PATTERNS.some((re) => re.test(head))) return false;
+  return details.every((clause) =>
+    PROVIDER_LIMIT_EXIT_DETAIL_RE.test(clause) && !PROVIDER_LIMIT_EXIT_WORK_REPORT_RE.test(clause));
+}