+  new RegExp(
+    String.raw`^(?!.*\b(?:token|context|length|output|scan|iteration|turn|step|time|retry|retries)\b)(?:[\w-]+\s+){0,3}${LIMIT_NOUN}\s+(?:has\s+been\s+)?(?:reached|exceeded|exhausted)(?:\s+for\s+(?:quota\s+metric\b.*|your\s+(?:subscription|plan|account|organi[sz]ation)|credits|(?:the\s+)?\d+[\s-]*hour\s+window|(?:model\s+)?[\w.:/-]*\d[\w.:/-]*))?${REQUEST_ID_SUFFIX}$`,
