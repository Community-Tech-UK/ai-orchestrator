+/**
+ * Chunked serializer for session-continuity payloads.
+ *
+ * A single `JSON.stringify` of a very large session (e.g. a restored
+ * 19k-message thread) builds one huge contiguous string, and the legacy
+ * envelope then stringifies that string a second time to escape it. Both
+ * passes can exceed what V8 can allocate and abort the main process.
+ *
+ * This module produces the exact same bytes as
+ * `JSON.stringify({ encrypted: false, data: JSON.stringify(value) })`
+ * but as a list of bounded chunks, so no step materialises the whole
+ * payload as one string. Writers stream the chunks to disk in order.
+ */
+
+/** A serialized payload: either one string or ordered chunks to concatenate. */
+export type ContinuityPayload = string | readonly string[];
+
+/** Target size (UTF-16 code units) at which pending tokens are flushed into a chunk. */
+export const CONTINUITY_PAYLOAD_CHUNK_CHARS = 1 << 20;
+
+class ChunkSink {
+  readonly chunks: string[] = [];
+  private pending: string[] = [];
+  private pendingLength = 0;
+
+  constructor(
+    private readonly chunkChars: number,
+    private readonly transform: (chunk: string) => string = (chunk) => chunk,
+  ) {}
+
+  push(token: string): void {
+    this.pending.push(token);
+    this.pendingLength += token.length;
+    if (this.pendingLength >= this.chunkChars) this.flush();
+  }
+
+  flush(): void {
+    if (this.pending.length === 0) return;
+    this.chunks.push(this.transform(this.pending.join('')));
+    this.pending = [];
+    this.pendingLength = 0;
+  }
+}
+
+/** Apply `toJSON(key)` the way `JSON.stringify` does before serializing a value. */
+function resolveValue(key: string, value: unknown): unknown {
+  if (value !== null && (typeof value === 'object' || typeof value === 'bigint')) {
+    const toJSON = (value as { toJSON?: unknown }).toJSON;
+    if (typeof toJSON === 'function') return toJSON.call(value, key);
+  }
+  return value;
+}
+
+function isOmitted(value: unknown): boolean {
+  return value === undefined || typeof value === 'function' || typeof value === 'symbol';
+}
+
+/**
+ * Append the JSON text of an already-resolved, non-omitted `value` to `sink`,
+ * mirroring `JSON.stringify` semantics (toJSON, boxed primitives, omitted
+ * undefined/function/symbol members, `null` for such array elements,
+ * circular-structure TypeError).
+ *
+ * Chunk boundaries only ever fall between whole tokens, and every token is
+ * well-formed `JSON.stringify` output, so a chunk never splits a surrogate
+ * pair. That keeps per-chunk string escaping identical to escaping the whole.
+ */
+function writeResolved(value: unknown, sink: ChunkSink, stack: Set<object>): void {
+  if (value === null || typeof value !== 'object'
+    || value instanceof Number || value instanceof String || value instanceof Boolean
+    || value instanceof BigInt) {
+    // Primitives and boxed primitives exactly as JSON.stringify (bigint throws).
+    sink.push(JSON.stringify(value));
+    return;
+  }
+
+  if (stack.has(value)) throw new TypeError('Converting circular structure to JSON');
+  stack.add(value);
+  try {
+    if (Array.isArray(value)) {
+      sink.push('[');
+      for (let index = 0; index < value.length; index++) {
+        if (index > 0) sink.push(',');
+        const element = resolveValue(String(index), value[index]);
+        if (isOmitted(element)) sink.push('null');
+        else writeResolved(element, sink, stack);
+      }
+      sink.push(']');
+      return;
+    }
+
+    const record = value as Record<string, unknown>;
+    let first = true;
+    sink.push('{');
+    for (const property of Object.keys(record)) {
+      const member = resolveValue(property, record[property]);
+      if (isOmitted(member)) continue;
+      sink.push(first ? `${JSON.stringify(property)}:` : `,${JSON.stringify(property)}:`);
+      first = false;
+      writeResolved(member, sink, stack);
+    }
+    sink.push('}');
+  } finally {
+    stack.delete(value);
+  }
+}
+
+/**
+ * Serialize `value` to JSON chunks equivalent to `JSON.stringify(value)`.
+ * Returns `undefined` when `JSON.stringify(value)` would return `undefined`.
+ */
+export function stringifyJsonChunks(
+  value: unknown,
+  chunkChars = CONTINUITY_PAYLOAD_CHUNK_CHARS,
+  transform?: (chunk: string) => string,
+): string[] | undefined {
+  const resolved = resolveValue('', value);
+  if (isOmitted(resolved)) return undefined;
+  const sink = new ChunkSink(chunkChars, transform);
+  writeResolved(resolved, sink, new Set<object>());
+  sink.flush();
+  return sink.chunks;
+}
+
+/**
+ * Build the plaintext `{ encrypted: false, data: "<json>" }` envelope as
+ * chunks. Byte-identical to
+ * `JSON.stringify({ encrypted: false, data: JSON.stringify(value) })`.
+ */
+export function serializePlainEnvelopeChunks(
+  value: unknown,
+  chunkChars = CONTINUITY_PAYLOAD_CHUNK_CHARS,
+): string[] {
+  // Escape each chunk as it is flushed so the unescaped JSON is never held in full.
+  const escapedChunks = stringifyJsonChunks(value, chunkChars, (chunk) => JSON.stringify(chunk).slice(1, -1));
+  if (escapedChunks === undefined) return [JSON.stringify({ encrypted: false, data: undefined })];
+  return ['{"encrypted":false,"data":"', ...escapedChunks, '"}'];
+}
+
+export function continuityPayloadChunks(payload: ContinuityPayload): readonly string[] {
+  return typeof payload === 'string' ? [payload] : payload;
+}
