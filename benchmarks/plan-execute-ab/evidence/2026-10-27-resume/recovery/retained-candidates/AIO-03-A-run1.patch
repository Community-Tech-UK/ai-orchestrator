+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import {
+  serializePlainEnvelopeChunks,
+  stringifyJsonChunks,
+} from './continuity-payload-serializer';
+import {
+  writeContinuityPayloadAsyncAtomic,
+  writeContinuityPayloadSyncAtomic,
+} from './continuity-recovery-metadata';
+
+const legacyEnvelope = (value: unknown): string =>
+  JSON.stringify({ encrypted: false, data: JSON.stringify(value) });
+
+function makeSession(messageCount: number): Record<string, unknown> {
+  return {
+    instanceId: 'inst-1',
+    displayName: 'Big "thread" \\ with\nnewlines',
+    provider: 'claude',
+    nothing: undefined,
+    fn: () => 1,
+    createdAt: new Date(0),
+    conversationHistory: Array.from({ length: messageCount }, (_, index) => ({
+      id: `m-${index}`,
+      role: index % 2 === 0 ? 'user' : 'assistant',
+      content: `message ${index} 😀 \u2028 é \t "quoted" </script>`,
+      timestamp: index,
+      metadata: index % 3 === 0 ? undefined : { tokens: index * 1.5, flags: [true, null, undefined] },
+    })),
+  };
+}
+
+describe('continuity payload serializer', () => {
+  const fixtures: [string, unknown][] = [
+    ['object', makeSession(25)],
+    ['primitives', [1, -0, 1.5e300, NaN, Infinity, 'x', true, false, null]],
+    ['lone surrogates', { a: '\ud83d', b: '\ude00x', c: 'ok\ud800' }],
+    ['sparse array', [1, , 3]], // eslint-disable-line no-sparse-arrays
+    ['boxed', [new Number(3), new String('s'), new Boolean(false)]],
+    ['toJSON omitted member', { a: { toJSON: () => undefined }, b: 1 }],
+    ['toJSON key', { k: { toJSON: (key: string) => `key:${key}` } }],
+    ['empty', { a: {}, b: [] }],
+    ['string', 'plain'],
+    ['null', null],
+  ];
+
+  it.each(fixtures)('matches JSON.stringify exactly for %s at every chunk size', (_name, value) => {
+    for (const chunkChars of [1, 2, 7, 64, 1 << 20]) {
+      expect(stringifyJsonChunks(value, chunkChars)?.join('')).toBe(JSON.stringify(value));
+      expect(serializePlainEnvelopeChunks(value, chunkChars).join('')).toBe(legacyEnvelope(value));
+    }
+  });
+
+  it('returns undefined where JSON.stringify does', () => {
+    expect(stringifyJsonChunks(undefined)).toBeUndefined();
+    expect(stringifyJsonChunks(() => 1)).toBeUndefined();
+    expect(serializePlainEnvelopeChunks(undefined).join('')).toBe(legacyEnvelope(undefined));
+  });
+
+  it('throws on circular structures and bigint like JSON.stringify', () => {
+    const cyclic: Record<string, unknown> = {};
+    cyclic['self'] = cyclic;
+    expect(() => stringifyJsonChunks(cyclic)).toThrow(TypeError);
+    expect(() => stringifyJsonChunks({ n: 1n })).toThrow(TypeError);
+    expect(() => stringifyJsonChunks({ n: Object(1n) })).toThrow(TypeError);
+  });
+
+  it('allows shared (non-circular) references', () => {
+    const shared = { x: 1 };
+    const value = { a: shared, b: [shared, shared] };
+    expect(stringifyJsonChunks(value, 3)?.join('')).toBe(JSON.stringify(value));
+  });
+
+  it('splits a large session into bounded chunks instead of one string', () => {
+    const chunkChars = 4096;
+    const session = makeSession(19_000);
+    const chunks = serializePlainEnvelopeChunks(session, chunkChars);
+
+    expect(chunks.length).toBeGreaterThan(100);
+    // Escaping can at most ~6x a chunk; no chunk approaches the full payload.
+    const total = chunks.reduce((sum, chunk) => sum + chunk.length, 0);
+    expect(Math.max(...chunks.map((chunk) => chunk.length))).toBeLessThan(total / 50);
+    expect(chunks.join('')).toBe(legacyEnvelope(session));
+  });
+});
+
+describe('continuity payload writers', () => {
+  let dir: string;
+  beforeEach(() => { dir = fs.mkdtempSync(path.join(os.tmpdir(), 'continuity-payload-')); });
+  afterEach(() => { fs.rmSync(dir, { recursive: true, force: true }); });
+
+  it('streams chunked payloads to disk byte-identically (async and sync)', async () => {
+    const session = makeSession(2_000);
+    const chunks = serializePlainEnvelopeChunks(session, 512);
+    const asyncFile = path.join(dir, 'async.json');
+    const syncFile = path.join(dir, 'sync.json');
+
+    await expect(writeContinuityPayloadAsyncAtomic(asyncFile, chunks)).resolves.toBe(true);
+    writeContinuityPayloadSyncAtomic(syncFile, chunks);
+
+    const expected = legacyEnvelope(session);
+    expect(fs.readFileSync(asyncFile, 'utf8')).toBe(expected);
+    expect(fs.readFileSync(syncFile, 'utf8')).toBe(expected);
+    const envelope = JSON.parse(fs.readFileSync(asyncFile, 'utf8')) as { data: string };
+    expect(JSON.parse(envelope.data)).toEqual(JSON.parse(JSON.stringify(session)));
+    expect(fs.readdirSync(dir).sort()).toEqual(['async.json', 'sync.json']);
+  });
+
+  it('still accepts a single-string payload', async () => {
+    const file = path.join(dir, 'plain.json');
+    await writeContinuityPayloadAsyncAtomic(file, '{"a":1}');
+    expect(fs.readFileSync(file, 'utf8')).toBe('{"a":1}');
+  });
+});
