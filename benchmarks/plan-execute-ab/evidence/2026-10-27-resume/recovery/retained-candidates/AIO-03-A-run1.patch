+/** Write payload chunks in order so a large payload never becomes one string. */
+async function writePayloadChunks(fh: FileHandle, serialized: ContinuityPayload): Promise<void> {
+  for (const chunk of continuityPayloadChunks(serialized)) {
+    const buffer = Buffer.from(chunk, 'utf8');
+    let offset = 0;
+    while (offset < buffer.length) {
+      const { bytesWritten } = await fh.write(buffer, offset, buffer.length - offset);
+      offset += bytesWritten;
+    }
+  }
+}
