+describe('KeyedSerialTaskQueue.whenIdle', () => {
+  it('stays pending while a turn queued before the call is open, then resolves', async () => {
+    const queue = new KeyedSerialTaskQueue();
+    let releaseGate!: () => void;
+    const gate = new Promise<void>((resolve) => {
+      releaseGate = resolve;
+    });
+
+    const running = queue.run('key-a', async () => gate);
+
+    let idle = false;
+    const idleSettled = queue.whenIdle().then(() => {
+      idle = true;
+    });
+    await Promise.resolve();
+    await Promise.resolve();
+    expect(idle).toBe(false);
+
+    releaseGate();
+    await Promise.all([running, idleSettled]);
+    expect(idle).toBe(true);
+  });
+
+  it('resolves when the open turn throws, since each turn releases in its finally', async () => {
+    const queue = new KeyedSerialTaskQueue();
+    let releaseGate!: () => void;
+    const gate = new Promise<void>((resolve) => {
+      releaseGate = resolve;
+    });
+
+    const failing = queue.run('key-a', async () => {
+      await gate;
+      throw new Error('task failed');
+    });
+
+    let idle = false;
+    const idleSettled = queue.whenIdle().then(() => {
+      idle = true;
+    });
+    releaseGate();
+
+    await expect(failing).rejects.toThrow('task failed');
+    await idleSettled;
+    expect(idle).toBe(true);
+  });
+});
