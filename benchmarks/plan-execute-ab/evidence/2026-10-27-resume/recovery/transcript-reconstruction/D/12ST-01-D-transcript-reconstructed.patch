+        class {
+          constructor(callback: () => void) {
+            fireResize = callback;
+          }
+          observe = observe;
+          disconnect = disconnect;
+          unobserve = vi.fn();
+        },
+      );
+    });
+
+    afterEach(() => vi.unstubAllGlobals());
+
+    it('redraws as compact when the column narrows below 300px', async () => {
+      const { fixture, host } = await setup(360);
+      expect(observe).toHaveBeenCalledWith(host);
+      expect(render).toHaveBeenLastCalledWith(host, expect.objectContaining({ size: 'normal' }));
+
+      width = 220;
+      fireResize();
+      await fixture.whenStable();
+
+      expect(remove).toHaveBeenCalledWith('widget-1');
+      expect(render).toHaveBeenCalledTimes(2);
+      expect(render).toHaveBeenLastCalledWith(host, expect.objectContaining({ size: 'compact' }));
+    });
+
+    it('redraws as normal when the column widens to 300px or more', async () => {
+      const { fixture, host } = await setup(220);
+      width = 360;
+      fireResize();
+      await fixture.whenStable();
+
+      expect(render).toHaveBeenCalledTimes(2);
+      expect(render).toHaveBeenLastCalledWith(host, expect.objectContaining({ size: 'normal' }));
+    });
+
+    it('does not redraw while the width stays on the same side of 300px', async () => {
+      const { fixture } = await setup(360);
+      width = 340;
+      fireResize();
+      await fixture.whenStable();
+
+      expect(render).toHaveBeenCalledTimes(1);
+      expect(remove).not.toHaveBeenCalled();
+    });
+
+    it('does not redraw when the column is hidden (zero width)', async () => {
+      const { fixture } = await setup(360);
+      width = 0;
+      fireResize();
+      await fixture.whenStable();
+
+      expect(render).toHaveBeenCalledTimes(1);
+      expect(remove).not.toHaveBeenCalled();
+    });
+
+    it('clears the token when it redraws', async () => {
+      const { fixture, emitted } = await setup(360);
+      expect(emitted).toEqual(['t']);
+
+      width = 220;
+      fireResize();
+
+      expect(emitted.at(-1)).toBe('');
+      expect(fixture.componentInstance.token()).toBe('');
+      await fixture.whenStable();
+    });
+
+    it('stops watching the width when destroyed', async () => {
+      const { fixture } = await setup(360);
+      fixture.destroy();
+      expect(disconnect).toHaveBeenCalledTimes(1);
+    });
+  });
 });
