+
+  describe('when the available width changes', () => {
+    let width: number;
+    let fireResize: () => void;
+    const observe = vi.fn();
+    const disconnect = vi.fn();
+    const render = vi.fn();
+    const remove = vi.fn();
+
+    async function setup(initialWidth: number) {
+      width = initialWidth;
+      let n = 0;
+      render.mockImplementation((_el: HTMLElement, opts: { callback?: (t: string) => void }) => {
+        opts.callback?.('t');
+        return `widget-${++n}`;
+      });
+      window.turnstile = { render, reset: vi.fn(), remove } as NonNullable<Window['turnstile']>;
+      const fixture = TestBed.createComponent(TurnstileWidgetComponent);
+      fixture.componentRef.setInput('siteKey', 'site-key');
+      const host = fixture.nativeElement.querySelector('.turnstile-widget') as HTMLElement;
+      Object.defineProperty(host, 'clientWidth', { configurable: true, get: () => width });
+      const emitted: string[] = [];
+      fixture.componentInstance.tokenChange.subscribe((value) => emitted.push(value));
+      fixture.detectChanges();
+      await fixture.whenStable();
+      return { fixture, host, emitted };
+    }
+
+    beforeEach(() => {
+      observe.mockClear();
+      disconnect.mockClear();
+      render.mockReset();
+      remove.mockReset();
+      vi.stubGlobal(
