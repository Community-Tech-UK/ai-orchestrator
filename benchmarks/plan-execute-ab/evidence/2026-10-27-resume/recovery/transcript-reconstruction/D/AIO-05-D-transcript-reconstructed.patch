diff --git a/src/main/cli/provider-notice.ts b/src/main/cli/provider-notice.ts
index a5d608d..10af0bc 100644
--- a/src/main/cli/provider-notice.ts
+++ b/src/main/cli/provider-notice.ts
@@ -38,3 +38,43 @@ export function isProviderNotice(text: string | null | undefined): boolean {
   if (!text) return false;
   return PROVIDER_NOTICE_PATTERNS.some((re) => re.test(text));
 }
+
+/**
+ * Strict limit patterns for {@link isProviderLimitNotice}. Unlike
+ * {@link PROVIDER_NOTICE_PATTERNS}, none of these match on a bare "too many
+ * requests", "quota exceeded", "rate limit" or "resets <time>", because those
+ * phrases routinely appear in genuine task output.
+ */
+export const PROVIDER_LIMIT_NOTICE_PATTERNS: readonly RegExp[] = [
+  /you(?:'?ve|\s+have)\s+(?:hit|reached)\s+your\s+(?:[\w-]+\s+){1,3}limit/i, // "You've hit your monthly spend limit"
+  /\b(?:claude\s+)?(?:ai\s+)?(?:usage|session|message)\s+limit\s+reached\b/i,
+  /\b\d+\s*-?\s*hour\s+limit\s+reached\b/i,
+  /\blimit\s*[·•∙‧]\s*resets?\b/i,
+  /\b(?:spend|spending)\s+(?:limit|cap)\s+(?:reached|exceeded|hit)\b/i,
+  /\bexceeded\s+your\s+(?:spend|spending|usage|budget)\s+limit\b/i,
+  /\bcredit\s+balance\s+is\s+too\s+low\b/i,
+  /\byou\s+exceeded\s+your\s+current\s+quota,?\s+please\s+check\s+your\s+plan\s+and\s+billing\b/i, // OpenAI/Codex
+  /\binsufficient_quota\b/i,
+  /\byou\s+have\s+exceeded\s+your\s+\w+\s+quota\b/i, // Copilot
+  /\b(?:daily|weekly|monthly)\s+quota\s+(?:exceeded|reached)\b/i,
+  /\bquota\s+exceeded\s+for\s+quota\s+metric\b/i, // Gemini
+  /\byou\s+have\s+exhausted\s+your\s+(?:[\w-]+\s+)*quota\b/i, // Gemini
+];
+
+const LIMIT_NOTICE_MAX_LENGTH = 600;
+const LIMIT_NOTICE_MAX_START = 120;
+
+/**
+ * Strict check for a provider usage/spend limit notice used as a run's final
+ * output. A real notice is short and leads the text (allowing prefixes such as
+ * "Error: " or "API Error: 429 "); a long report that merely quotes one, or
+ * mentions limit wording mid-paragraph, is genuine output and is not matched.
+ */
+export function isProviderLimitNotice(text: string | null | undefined): boolean {
+  const trimmed = text?.trim();
+  if (!trimmed || trimmed.length > LIMIT_NOTICE_MAX_LENGTH) return false;
+  return PROVIDER_LIMIT_NOTICE_PATTERNS.some((re) => {
+    const match = re.exec(trimmed);
+    return match !== null && match.index <= LIMIT_NOTICE_MAX_START;
+  });
+}
