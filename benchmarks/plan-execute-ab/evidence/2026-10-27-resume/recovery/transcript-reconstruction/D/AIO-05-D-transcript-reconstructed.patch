--- /dev/null
+++ b/src/main/automations/automation-provider-limit-outcome.ts
@@ -0,0 +1,21 @@
+import { isProviderLimitNotice } from '../cli/provider-notice';
+import type { OutputMessage } from '../../shared/types/instance.types';
+
+/**
+ * Decide whether an automation run that looked like a clean finish actually
+ * ended on a provider usage/spend limit. Returns a failure reason, or null.
+ * Automation runs always start a fresh session, so any parked-session marker in
+ * the buffer belongs to this run.
+ */
+export function detectAutomationProviderLimit(input: {
+  lastAssistantOutput?: string | null;
+  outputBuffer?: readonly OutputMessage[] | null;
+}): string | null {
+  if (input.outputBuffer?.some((m) => m.metadata?.['providerLimitParked'] === true)) {
+    return 'Provider limit reached: session parked until the limit resets';
+  }
+  if (isProviderLimitNotice(input.lastAssistantOutput)) {
+    return `Provider limit reached: ${input.lastAssistantOutput!.trim().slice(0, 200)}`;
+  }
+  return null;
+}
