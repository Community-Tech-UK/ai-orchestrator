+import { describe, expect, it } from 'vitest';
+import type { OutputMessage } from '../../shared/types/instance.types';
+import { detectAutomationProviderLimit } from './automation-provider-limit-outcome';
+
+describe('detectAutomationProviderLimit', () => {
+  it('returns null for ordinary output', () => {
+    expect(detectAutomationProviderLimit({ lastAssistantOutput: 'All done, resets at 6pm' })).toBeNull();
+  });
+
+  it('reports a final limit notice', () => {
+    expect(detectAutomationProviderLimit({ lastAssistantOutput: "You've hit your session limit · resets 6:30pm" }))
+      .toMatch(/^Provider limit reached: You've hit/);
+  });
+
+  it('reports a parked session', () => {
+    const outputBuffer = [
+      { id: '1', type: 'system', content: 'x', timestamp: 1, metadata: { providerLimitParked: true } },
+    ] as OutputMessage[];
+    expect(detectAutomationProviderLimit({ lastAssistantOutput: 'fine', outputBuffer }))
+      .toContain('parked');
+  });
+});
diff --git a/src/main/automations/automation-provider-limit-outcome.ts b/src/main/automations/automation-provider-limit-outcome.ts
