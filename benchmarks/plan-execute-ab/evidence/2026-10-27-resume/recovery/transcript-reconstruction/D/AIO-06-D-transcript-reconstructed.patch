+import { describe, expect, it, vi } from 'vitest';
+import { createInitialPromptLimitHooks } from './instance-communication-provider-limit';
+import type { Instance } from '../../shared/types/instance.types';
+
+function setup(overrides: { check?: () => string; park?: () => boolean } = {}) {
+  const instance = { id: 'i1', provider: 'codex', currentModel: 'gpt', status: 'idle', contextUsage: undefined } as unknown as Instance;
+  const rememberLastSent = vi.fn();
+  const park = vi.fn(overrides.park ?? (() => true));
+  const queueUpdate = vi.fn();
+  const onToolStateChange = vi.fn();
+  const check = vi.fn(overrides.check ?? (() => 'proceed'));
+  const hooks = createInitialPromptLimitHooks({
+    deps: {
+      getInstance: () => instance,
+      getAdapter: () => ({}) as never,
+      checkKnownProviderLimitBeforeSend: check as never,
+      onToolStateChange,
+      queueUpdate,
+    },
+    rememberLastSent,
+    park,
+  });
+  return { hooks, rememberLastSent, park, queueUpdate, onToolStateChange, check };
+}
+
+describe('initial prompt provider-limit hooks', () => {
+  it('records the prompt as the resume text and reports a known limit', () => {
+    const t = setup({ check: () => 'parked' });
+    expect(t.hooks.preflight('i1', 'hello')).toBe(true);
+    expect(t.rememberLastSent).toHaveBeenCalledWith('i1', { message: 'hello' });
+    expect(t.check).toHaveBeenCalledWith(expect.objectContaining({ prompt: 'hello', provider: 'codex' }));
+  });
+
+  it('lets the prompt through when no limit is known', () => {
+    expect(setup().hooks.preflight('i1', 'hello')).toBe(false);
+  });
+
+  it('parks with the user prompt and settles tool state', () => {
+    const t = setup();
+    expect(t.hooks.park('i1', new Error('usage limit'), 'hello')).toBe(true);
+    expect(t.park).toHaveBeenCalledWith(expect.anything(), expect.anything(), expect.any(Error), 'usage limit', 'hello');
+    expect(t.onToolStateChange).toHaveBeenCalledWith('i1', 'idle');
+    expect(t.queueUpdate).toHaveBeenCalled();
+  });
+
+  it('returns false when the funnel declines', () => {
+    const t = setup({ park: () => false });
+    expect(t.hooks.park('i1', new Error('x'), 'hello')).toBe(false);
+    expect(t.queueUpdate).not.toHaveBeenCalled();
+  });
+});
