+function isParsedWindow(value: unknown): boolean {
+  if (value === null) return true;
+  const raw = record(value);
+  return raw !== null && typeof raw['usedPercent'] === 'number' && 'windowDurationMins' in raw;
+}
+
+/**
+ * True only for an already-parsed snapshot (exactly the keys `parseCodexRateLimitSnapshot`
+ * emits). Raw app-server payloads carry `credits`, never `creditsAvailable`, so they
+ * always go through the parser even when they include `rateLimitReachedType`.
+ */
+export function isCodexRateLimitSnapshot(value: unknown): value is CodexRateLimitSnapshot {
+  const raw = record(value);
+  if (!raw) return false;
+  for (const key of ['primary', 'secondary', 'planType', 'rateLimitReachedType', 'creditsAvailable']) {
+    if (!(key in raw)) return false;
+  }
+  const credits = raw['creditsAvailable'];
+  return (credits === null || typeof credits === 'boolean') && isParsedWindow(raw['primary']) && isParsedWindow(raw['secondary']);
+}
