+/** Parked prompt if it has text, else the fallback if it has text, else null (send nothing). */
+export function pickResumePrompt(
+  parked: string | null | undefined,
+  fallback: string | null | undefined,
+): string | null {
+  if (parked && parked.trim().length > 0) return parked;
+  if (fallback && fallback.trim().length > 0) return fallback;
+  return null;
