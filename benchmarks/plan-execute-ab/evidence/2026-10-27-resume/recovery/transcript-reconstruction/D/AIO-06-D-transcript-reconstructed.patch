+export interface InitialPromptLimitContext {
+  deps: Pick<CommunicationDependencies, 'getInstance' | 'getAdapter' | 'checkKnownProviderLimitBeforeSend' | 'onToolStateChange' | 'queueUpdate'>;
+  rememberLastSent: (instanceId: string, turn: { message: string }) => void;
+  /** Runs the shared park funnel with `prompt` as the resume text. */
+  park: (instance: Instance, adapter: CliAdapter, error: unknown, errorMessage: string, prompt: string) => boolean;
+}
+
+/**
+ * Provider-limit hooks for the create-time initial prompt, which is delivered by
+ * the lifecycle manager straight to the adapter and so bypasses `sendInput()`
+ * (known-limit preflight and last-sent tracking).
+ */
+export function createInitialPromptLimitHooks(ctx: InitialPromptLimitContext): {
+  /** Records the prompt as the resume text; true = a known limit already took the turn (parked / switching). */
+  preflight: (instanceId: string, prompt: string) => boolean;
+  /** The send hit a provider limit: park the prompt. True = handled, so skip the generic failure notice. */
+  park: (instanceId: string, error: unknown, prompt: string) => boolean;
+} {
+  return {
+    preflight: (instanceId, prompt) => {
+      const instance = ctx.deps.getInstance(instanceId);
+      ctx.rememberLastSent(instanceId, { message: prompt });
+      return !!instance && shouldSkipKnownProviderLimitDispatch(ctx.deps.checkKnownProviderLimitBeforeSend, {
+        instanceId, provider: instance.provider, model: instance.currentModel ?? null, prompt,
+      });
+    },
+    park: (instanceId, error, prompt) => {
+      const instance = ctx.deps.getInstance(instanceId);
+      const adapter = ctx.deps.getAdapter(instanceId);
+      if (!instance || !adapter) return false;
+      const errorMessage = error instanceof Error ? error.message : String(error);
+      if (!ctx.park(instance, adapter, error, errorMessage, prompt)) return false;
+      ctx.deps.onToolStateChange?.(instanceId, 'idle');
+      ctx.deps.queueUpdate(instanceId, instance.status, instance.contextUsage);
+      return true;
+    },
+  };
+}
