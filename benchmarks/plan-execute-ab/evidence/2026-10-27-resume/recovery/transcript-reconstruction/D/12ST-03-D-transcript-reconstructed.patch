diff --git a/apps/web/src/app/shared/util/android-device.spec.ts b/apps/web/src/app/shared/util/android-device.spec.ts
new file mode 100644
index 0000000..0328b50
--- /dev/null
+++ b/apps/web/src/app/shared/util/android-device.spec.ts
@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest';
+import { isAndroidBrowser } from './android-device';
+
+describe('isAndroidBrowser', () => {
+  it('detects an Android Chrome user agent', () => {
+    expect(
+      isAndroidBrowser({
+        userAgent: 'Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 Chrome/126 Mobile',
+      }),
+    ).toBe(true);
+  });
+
+  it('rejects iPhone and desktop user agents', () => {
+    expect(
+      isAndroidBrowser({ userAgent: 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X)' }),
+    ).toBe(false);
+    expect(
+      isAndroidBrowser({ userAgent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/126' }),
+    ).toBe(false);
+  });
+
+  it('uses userAgentData.platform when present', () => {
+    expect(isAndroidBrowser({ userAgent: '', userAgentData: { platform: 'Android' } })).toBe(true);
+  });
+
+  it('is false without a navigator', () => {
+    expect(isAndroidBrowser(null)).toBe(false);
+  });
+});
diff --git a/apps/web/src/app/shared/util/android-device.ts b/apps/web/src/app/shared/util/android-device.ts
new file mode 100644
index 0000000..f1c3f8f
--- /dev/null
+++ b/apps/web/src/app/shared/util/android-device.ts
@@ -0,0 +1,10 @@
+interface AndroidNavigator {
+  readonly userAgent?: string;
+  readonly userAgentData?: { readonly platform?: string };
+}
+
+/** True when the visitor is browsing from an Android device. */
+export function isAndroidBrowser(nav: AndroidNavigator | null = globalThis.navigator): boolean {
+  if (!nav) return false;
+  return nav.userAgentData?.platform === 'Android' || /Android/i.test(nav.userAgent ?? '');
+}
