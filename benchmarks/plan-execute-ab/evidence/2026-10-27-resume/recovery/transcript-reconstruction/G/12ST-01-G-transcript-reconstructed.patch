     );
   });
+
+  describe('column resizing', () => {
+    let notifyResize: () => void;
+    const observe = vi.fn();
+    const disconnect = vi.fn();
+
+    beforeEach(() => {
+      observe.mockClear();
+      disconnect.mockClear();
+      notifyResize = () => undefined;
+      vi.stubGlobal('ResizeObserver', class {
+        observe = observe;
+        disconnect = disconnect;
+
+        constructor(callback: ResizeObserverCallback) {
+          notifyResize = () => callback([], this as unknown as ResizeObserver);
+        }
+      });
+    });
+
+    afterEach(() => vi.unstubAllGlobals());
+
+    it('switches sizes when the column crosses 300px and clears the old token', async () => {
+      const render = vi.fn<NonNullable<Window['turnstile']>['render']>()
+        .mockReturnValueOnce('widget-1')
+        .mockReturnValueOnce('widget-2')
+        .mockReturnValue('widget-3');
+      const remove = vi.fn();
+      window.turnstile = { render, remove, reset: vi.fn() };
+      const fixture = TestBed.createComponent(TurnstileWidgetComponent);
+      fixture.componentRef.setInput('siteKey', 'site-key');
+      const emitted: string[] = [];
+      fixture.componentInstance.tokenChange.subscribe((value) => emitted.push(value));
+      fixture.detectChanges();
+      const host = fixture.nativeElement.querySelector('.turnstile-widget') as HTMLElement;
+      let width = 360;
+      Object.defineProperty(host, 'clientWidth', { get: () => width });
+      await fixture.whenStable();
+      expect(render).toHaveBeenLastCalledWith(host, expect.objectContaining({ size: 'normal' }));
+      const options = render.mock.calls[0][1];
+      options.callback?.('old-token');
+
+      width = 299;
+      notifyResize();
+      await fixture.whenStable();
+
+      expect(remove).toHaveBeenCalledWith('widget-1');
+      expect(render).toHaveBeenCalledTimes(2);
+      expect(render).toHaveBeenLastCalledWith(host, expect.objectContaining({ size: 'compact' }));
+      expect(fixture.componentInstance.token()).toBe('');
+      expect(emitted).toEqual(['old-token', '']);
+
+      width = 300;
+      notifyResize();
+      await fixture.whenStable();
+      expect(remove).toHaveBeenCalledWith('widget-2');
+      expect(render).toHaveBeenCalledTimes(3);
+      expect(render).toHaveBeenLastCalledWith(host, expect.objectContaining({ size: 'normal' }));
+    });
+
+    it('keeps the widget for notifications that do not require a different size', async () => {
+      const render = vi.fn(() => 'widget-1');
+      const remove = vi.fn();
+      window.turnstile = { render, remove, reset: vi.fn() };
+      const fixture = TestBed.createComponent(TurnstileWidgetComponent);
+      fixture.componentRef.setInput('siteKey', 'site-key');
+      fixture.detectChanges();
+      const host = fixture.nativeElement.querySelector('.turnstile-widget') as HTMLElement;
+      let width = 360;
+      Object.defineProperty(host, 'clientWidth', { get: () => width });
+      // The initial observation can arrive before the first mount finishes.
+      notifyResize();
+      await fixture.whenStable();
+      width = 320;
+      notifyResize();
+      await fixture.whenStable();
+      notifyResize();
+      await fixture.whenStable();
+
+      expect(render).toHaveBeenCalledTimes(1);
+      expect(remove).not.toHaveBeenCalled();
+    });
+
+    it('disconnects on destruction and ignores queued resize notifications', async () => {
+      const render = vi.fn(() => 'widget-1');
+      const remove = vi.fn();
+      window.turnstile = { render, remove, reset: vi.fn() };
+      const fixture = TestBed.createComponent(TurnstileWidgetComponent);
+      fixture.componentRef.setInput('siteKey', 'site-key');
+      fixture.detectChanges();
+      await fixture.whenStable();
+      expect(observe).toHaveBeenCalledWith(fixture.nativeElement.querySelector('.turnstile-widget'));
+
+      fixture.destroy();
+      notifyResize();
+      await Promise.resolve();
+
+      expect(disconnect).toHaveBeenCalledTimes(1);
+      expect(remove).toHaveBeenCalledWith('widget-1');
+      expect(render).toHaveBeenCalledTimes(1);
+    });
+  });
 });
