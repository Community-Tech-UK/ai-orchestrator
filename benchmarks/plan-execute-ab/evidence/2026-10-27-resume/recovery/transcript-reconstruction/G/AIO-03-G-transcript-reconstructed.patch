+    }
+    if (mode === 'async') {
+      await expect(writeContinuityPayloadAsyncAtomic(file, failingChunks())).rejects.toThrow('fixture serialization failure');
+    } else {
+      expect(() => writeContinuityPayloadSyncAtomic(file, failingChunks())).toThrow('fixture serialization failure');
+    }
+    expect(await fs.promises.readFile(file, 'utf8')).toBe('previous state');
+    expect(await fs.promises.readdir(directory)).toEqual(['state.json']);
+  });
+
+  it('does not publish fragmented output after its write epoch becomes stale', async () => {
+    directory = await fs.promises.mkdtemp(path.join(process.cwd(), '_scratch/chunk-write-'));
+    const file = path.join(directory, 'state.json');
