+
+  it.each([false, true])('saves 19k restored messages and provider identity without whole-payload stringify (encryption=%s)', async (encryptOnDisk) => {
+    mocks.root = await fs.promises.mkdtemp(path.join(process.cwd(), '_scratch/large-save-'));
+    mocks.encryptionAvailable = true;
+    manager = new SessionContinuityManager({ autoSaveEnabled: false, encryptOnDisk, maxConversationEntries: 20000 });
