+    const toJSON: unknown = (value as { toJSON?: unknown }).toJSON;
+    if (typeof toJSON === 'function') value = toJSON.call(value, key);
+  }
+  if (types.isNumberObject(value)) return Number(value);
+  if (types.isStringObject(value)) return String(value);
+  if (types.isBooleanObject(value)) return Boolean.prototype.valueOf.call(value);
+  if (types.isBigIntObject(value)) return BigInt.prototype.valueOf.call(value);
+  return value;
+}
+
+function omitted(value: unknown): boolean {
+  return value === undefined || typeof value === 'function' || typeof value === 'symbol';
+}
+
+/** JSON.stringify semantics for session data, without stringifying a container or long string. */
+function* jsonTokens(value: unknown, ancestors: Set<object>): Generator<string> {
+  if (typeof value === 'string') {
+    yield* quoted(value);
+  } else if (value === null || typeof value !== 'object') {
+    // Native stringify preserves number formatting/non-finite handling and rejects BigInt.
+    yield JSON.stringify(value);
+  } else {
+    if (ancestors.has(value)) throw new TypeError('Converting circular structure to JSON');
+    ancestors.add(value);
+    try {
+      if (Array.isArray(value)) {
+        yield '[';
+        const length = value.length;
+        for (let index = 0; index < length; index++) {
+          if (index > 0) yield ',';
+          const item = prepare(value[index], String(index));
+          yield* jsonTokens(omitted(item) ? null : item, ancestors);
+        }
+        yield ']';
+      } else {
+        yield '{';
+        let first = true;
+        for (const key of Object.keys(value)) {
+          const item = prepare((value as Record<string, unknown>)[key], key);
+          if (omitted(item)) continue;
+          if (!first) yield ',';
+          first = false;
+          yield* quoted(key);
+          yield ':';
+          yield* jsonTokens(item, ancestors);
+        }
+        yield '}';
+      }
+    } finally {
+      ancestors.delete(value);
+    }
+  }
+}
+
+/** Coalesce small tokens so streaming a large history does not issue a write per field. */
+function* buffered(tokens: Iterable<string>): Generator<string> {
+  let parts: string[] = [];
+  let length = 0;
+  for (const token of tokens) {
+    if (length + token.length > WRITE_CHUNK_SIZE) {
+      yield parts.join('');
+      parts = [];
+      length = 0;
+    }
+    parts.push(token);
+    length += token.length;
+  }
+  if (length > 0) yield parts.join('');
+}
+
+function* envelope(data: unknown, encryptOnDisk: boolean): Generator<string> {
+  const prepared = prepare(data, '');
+  const tokens = omitted(prepared) ? [] : jsonTokens(prepared, new Set<object>());
+  if (encryptOnDisk) {
+    const safeStorage = getSafeStorage();
+    if (safeStorage.isEncryptionAvailable()) {
+      const chunks = Array.from(buffered(tokens));
+      if (omitted(prepared)) throw new TypeError('Cannot encrypt an undefined JSON payload');
+      // Retain the original envelope for small payloads; larger saves encrypt bounded fragments.
+      const chunked = chunks.length > 1;
+      yield '{"encrypted":true,"data":';
+      if (chunked) yield '[';
+      for (let index = 0; index < chunks.length; index++) {
+        if (index > 0) yield ',';
+        yield* quoted(safeStorage.encryptString(chunks[index]).toString('base64'));
+      }
+      if (chunked) yield ']';
+      yield '}';
+      return;
+    }
+  }
+  if (omitted(prepared)) {
+    yield '{"encrypted":false}';
+    return;
+  }
+  yield '{"encrypted":false,"data":"';
+  // Keep the legacy JSON-in-a-string envelope, escaping each token instead of the whole JSON.
+  for (const token of tokens) yield* stringBody(token);
+  yield '"}';
+}
+
+export function serializeSessionPayload(data: unknown, encryptOnDisk: boolean): Iterable<string> {
+  // Capture the save synchronously as before: updates may arrive during async disk I/O.
+  // Retain bounded fragments, never a single string containing the whole plaintext envelope.
+  return Array.from(buffered(envelope(data, encryptOnDisk)));
+}
+
+export function isEncryptedSessionData(data: unknown): data is string | string[] {
+  return typeof data === 'string'
+    || Array.isArray(data) && data.length > 0 && data.every((chunk) => typeof chunk === 'string');
+}
+
+/** Decode both the original single ciphertext and the bounded ciphertext array format. */
+export function decryptSessionData(data: string | string[]): string {
+  const safeStorage = getSafeStorage();
+  const decrypt = (chunk: string): string => safeStorage.decryptString(Buffer.from(chunk, 'base64'));
+  return typeof data === 'string' ? decrypt(data) : data.map(decrypt).join('');
+}
