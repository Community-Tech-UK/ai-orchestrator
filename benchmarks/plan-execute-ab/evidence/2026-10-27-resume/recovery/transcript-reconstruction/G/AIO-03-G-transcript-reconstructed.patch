+import { types } from 'node:util';
+import { getSafeStorage } from './safe-storage-accessor';
+
+const STRING_CHUNK_SIZE = 8192;
+const WRITE_CHUNK_SIZE = 65536;
+
+/** Escape bounded slices, keeping surrogate pairs together for identical JSON/UTF-8. */
+function* stringBody(value: string): Generator<string> {
+  for (let start = 0; start < value.length;) {
+    let end = Math.min(start + STRING_CHUNK_SIZE, value.length);
+    const last = value.charCodeAt(end - 1);
+    const next = value.charCodeAt(end);
+    if (last >= 0xd800 && last <= 0xdbff && next >= 0xdc00 && next <= 0xdfff) end--;
+    yield JSON.stringify(value.slice(start, end)).slice(1, -1);
+    start = end;
+  }
+}
+
+function* quoted(value: string): Generator<string> {
+  yield '"';
+  yield* stringBody(value);
+  yield '"';
+}
+
+function prepare(value: unknown, key: string): unknown {
