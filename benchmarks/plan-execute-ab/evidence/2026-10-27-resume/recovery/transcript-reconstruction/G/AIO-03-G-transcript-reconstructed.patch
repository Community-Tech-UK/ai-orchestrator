+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { serializeSessionPayload } from './session-payload-serializer';
+import { writeContinuityPayloadAsyncAtomic, writeContinuityPayloadSyncAtomic } from './continuity-recovery-metadata';
+
+vi.mock('../util/cleanup-registry', () => ({ registerCleanup: () => vi.fn() }));
+
+beforeEach(async () => {
+  await fs.promises.mkdir(path.join(process.cwd(), '_scratch'), { recursive: true });
+});
+
+describe('session payload serializer', () => {
+  it('matches native JSON semantics for ordinary session values', () => {
+    const shared = { repeated: true };
+    const data = {
+      missing: undefined, fn: () => undefined, symbol: Symbol('omitted'),
+      array: [undefined, , () => undefined, Symbol('null'), NaN, Infinity, -Infinity, -0],
+      nested: { text: '\u0000\b\f\n\r\t"\\😀\ud800\udc00', empty: {}, null: null },
+      date: new Date('2026-01-01T00:00:00Z'),
+      keys: { 10: 'ten', 2: 'two', first: 1 },
+      toJSONValue: { toJSON(key: string) { return { key }; } },
+      boxed: [new Number(2), new String('text'), new Boolean(false)],
+      shared: [shared, shared],
+    };
+    expect(Array.from(serializeSessionPayload(data, false)).join('')).toBe(
+      JSON.stringify({ encrypted: false, data: JSON.stringify(data) }),
+    );
+  });
+
+  it('bounds chunks and preserves long keys, strings, escapes and split surrogate pairs', () => {
+    const text = 'x'.repeat(8191) + '😀' + '\u0000"\\\n\ud800'.repeat(100000);
+    const data = { [text]: text, nested: [text] };
+    const nativeStringify = JSON.stringify;
+    const expected = nativeStringify({ encrypted: false, data: nativeStringify(data) });
+    const guard = vi.spyOn(JSON, 'stringify').mockImplementation((value, replacer, space) => {
+      expect(typeof value).not.toBe('object');
+      if (typeof value === 'string') expect(value.length).toBeLessThanOrEqual(8192);
+      return nativeStringify(value, replacer, space);
+    });
+    let chunks: string[];
+    try {
+      chunks = Array.from(serializeSessionPayload(data, false));
+    } finally {
+      guard.mockRestore();
+    }
+    expect(chunks.length).toBeGreaterThan(1);
+    expect(chunks.every((chunk) => chunk.length <= 65536)).toBe(true);
+    expect(Buffer.concat(chunks.map((chunk) => Buffer.from(chunk))).toString()).toBe(expected);
+  });
+
+  it('captures the payload before asynchronous writes can observe mutations', () => {
+    const data = { messages: ['before'] };
+    const chunks = serializeSessionPayload(data, false);
+    data.messages.push('after');
+    const envelope = JSON.parse(Array.from(chunks).join(''));
+    expect(JSON.parse(envelope.data)).toEqual({ messages: ['before'] });
+  });
+
+  it('rejects cycles and BigInt rather than silently losing data', () => {
+    const cycle: Record<string, unknown> = {};
+    cycle['self'] = cycle;
+    for (const value of [cycle, { bigint: 1n }, { boxed: Object(1n) }]) {
+      expect(() => Array.from(serializeSessionPayload(value, false))).toThrow(TypeError);
+    }
+  });
+});
+
+describe('atomic fragmented writes', () => {
+  let directory = '';
+  afterEach(async () => {
+    if (directory) await fs.promises.rm(directory, { recursive: true, force: true });
+  });
+
+  it.each(['async', 'sync'])('keeps the old file and cleans staging files on a failed %s write', async (mode) => {
+    directory = await fs.promises.mkdtemp(path.join(process.cwd(), '_scratch/chunk-write-'));
+    const file = path.join(directory, 'state.json');
+    await fs.promises.writeFile(file, 'previous state');
+    function* failingChunks(): Generator<string> {
