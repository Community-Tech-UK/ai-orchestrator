+    manager.shutdown();
+    const decrypt = mocks.decryptString.getMockImplementation()!;
+    mocks.decryptString.mockImplementation((value: Buffer) => {
+      if (value.includes(Buffer.from('fixture text'))) throw new Error('fixture decryption failure');
+      return decrypt(value);
