+import { describe, expect, it } from 'vitest';
+import type { OutputMessage } from '../../shared/types/instance.types';
+import { mergeArchiveMessages } from './history-archive-merge';
+import { continuityEntryToOutputMessage, outputMessagesToContinuityEntries } from '../session/continuity-message-projection';
+
+function message(id: string, overrides: Partial<OutputMessage> = {}): OutputMessage {
+  return { id, type: 'assistant', content: 'Repeated output', timestamp: 100, ...overrides };
+}
+
+describe('mergeArchiveMessages', () => {
+  it('keeps old-only messages in time order and prefers current messages by id', () => {
+    const old = [message('old', { timestamp: 50 }), message('shared')];
+    const current = [message('new', { timestamp: 75 }), message('shared', {
+      content: 'Updated output', metadata: { complete: true },
+    })];
+    expect(mergeArchiveMessages(old, current)).toEqual([old[0], ...current]);
+    expect(old[1]?.content).toBe('Repeated output');
+  });
+
+  it('prefers the current copy when revival renumbered its id', () => {
+    const old = message('old');
+    const current = message('restored-0', { metadata: { restored: true } });
+    expect(mergeArchiveMessages([old], [current])).toEqual([current]);
+  });
+
+  it('matches renumbered copies one-for-one while preserving repeated occurrences', () => {
+    const old = [message('old-1'), message('old-2')];
+    const current = [message('restored-1'), message('restored-2'), message('new-3')];
+    expect(mergeArchiveMessages(old, current)).toEqual(current);
+    expect(mergeArchiveMessages(old, [current[0]!])).toEqual([old[1], current[0]]);
+  });
+
+  it('reserves id matches before matching renumbered copies', () => {
+    const old = [message('same'), message('other')];
+    const current = [message('renumbered'), message('same', { content: 'Updated output' })];
+    expect(mergeArchiveMessages(old, current)).toEqual(current);
+  });
+
+  it.each(['tool_use', 'tool_result', 'tool_outcome'] as const)(
+    'preserves parallel %s records with identical timestamps and content', (type) => {
+      const old = message('old-call', { type, metadata: { tool_use_id: 'call-alpha' } });
+      const current = message('new-call', { type, metadata: { tool_use_id: 'call-beta' } });
+      expect(mergeArchiveMessages([old], [current])).toEqual([old, current]);
+    },
+  );
+
+  it('recognizes tool metadata aliases and input object key order after revival', () => {
+    const old = message('old', { type: 'tool_use', metadata: {
+      toolCallId: 'call-alpha', name: 'read', input: { path: 'placeholder', offset: 0 },
+    } });
+    const current = message('restored', { type: 'tool_use', metadata: {
+      id: 'call-alpha', toolName: 'read', input: { offset: 0, path: 'placeholder' },
+    } });
+    expect(mergeArchiveMessages([old], [current])).toEqual([current]);
+  });
+
+  it('deduplicates renumbered tool results whose name was inferred during revival', () => {
+    const old = [
+      message('call', { type: 'tool_use', metadata: {
+        id: 'call-alpha', toolName: 'read', input: { path: 'placeholder' },
+      } }),
+      message('result', { type: 'tool_result', content: 'ok', metadata: { tool_use_id: 'call-alpha' } }),
+    ];
+    const current = outputMessagesToContinuityEntries(old).map((entry, index) => ({
+      ...continuityEntryToOutputMessage(entry), id: `restored-${index}`,
+    }));
+    expect(mergeArchiveMessages(old, current)).toEqual(current);
+  });
+
+  it('keeps messages with different types, timestamps, or tool inputs', () => {
+    const old = message('old');
+    const current = [message('user', { type: 'user' }), message('later', { timestamp: 101 })];
+    expect(mergeArchiveMessages([old], current)).toEqual([old, ...current]);
+    const call = message('tool', { type: 'tool_use', metadata: { input: { path: 'one' } } });
+    const otherCall = message('other-tool', { ...call, id: 'other-tool', metadata: { input: { path: 'two' } } });
+    expect(mergeArchiveMessages([call], [otherCall])).toEqual([call, otherCall]);
+  });
+
+  it('handles empty sources', () => {
+    const current = [message('current')];
+    expect(mergeArchiveMessages([], current)).toEqual(current);
+    expect(mergeArchiveMessages(current, [])).toEqual(current);
+    expect(mergeArchiveMessages([], [])).toEqual([]);
+  });
+});
