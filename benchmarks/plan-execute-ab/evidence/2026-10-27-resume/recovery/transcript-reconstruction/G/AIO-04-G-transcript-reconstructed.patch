+import type { OutputMessage } from '../../shared/types/instance.types';
+import { outputMessageToContinuityEntry } from '../session/continuity-message-projection';
+import type { ConversationData, ConversationHistoryEntry } from '../../shared/types/history.types';
+import { resolveHistoryRecoveryCoverage } from './history-recovery-coverage';
+import { getArchiveHistoryIdentity, type ArchiveHistoryCoverage, type ArchiveInstanceSummary } from './should-archive-instance';
+
+function stableValue(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(stableValue);
+  if (value && typeof value === 'object') {
+    return Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b))
+      .map(([key, item]) => [key, stableValue(item)]));
+  }
+  return value;
+}
+
+function fingerprint(message: OutputMessage): string {
+  let toolIdentity: unknown;
+  if (message.type === 'tool_use' || message.type === 'tool_result' || message.type === 'tool_outcome') {
+    // Project only identity-bearing fields: unrelated legacy optional fields
+    // (such as malformed thinking) must not make an old archive unreadable.
+    const toolUse = outputMessageToContinuityEntry({
+      id: message.id, timestamp: message.timestamp, content: message.content,
+      type: message.type === 'tool_outcome' ? 'tool_result' : message.type,
+      metadata: message.metadata,
+    }).toolUse;
+    const callId = toolUse?.callId ?? toolUse?.resultForCallId;
+    toolIdentity = {
+      callId,
+      // Revival can infer a result's missing tool name from its call. The
+      // stable call id identifies it regardless of that enrichment.
+      ...(callId ? {} : { toolName: toolUse?.toolName }),
+      ...(message.type === 'tool_use' ? { input: toolUse?.input } : {}),
+    };
+  }
+  return JSON.stringify([message.type, message.timestamp, message.content, stableValue(toolIdentity)]);
+}
+
+/** Lossless union of two snapshots; current copies win and inputs stay untouched. */
+export function mergeArchiveMessages(
+  archived: readonly OutputMessage[],
+  current: readonly OutputMessage[],
+): OutputMessage[] {
+  const archivedById = new Map(archived.map(message => [message.id, message]));
+  const currentById = new Map(current.map(message => [message.id, message]));
+  const unmatched = [...archivedById.values()].filter(message => !currentById.has(message.id));
+  const copies = new Map<string, OutputMessage[]>();
+  for (const message of [...unmatched].reverse()) {
+    const key = fingerprint(message);
+    const group = copies.get(key) ?? [];
+    group.push(message);
+    copies.set(key, group);
+  }
+  const replaced = new Set<OutputMessage>();
+  for (const message of currentById.values()) {
+    // An id match has already consumed exactly one archived copy. Do not let
+    // it also consume a different message through its fingerprint.
+    if (archivedById.has(message.id)) continue;
+    const match = copies.get(fingerprint(message))?.pop();
+    if (match) replaced.add(match);
+  }
+  return [...unmatched.filter(message => !replaced.has(message)), ...currentById.values()]
+    .sort((a, b) => a.timestamp - b.timestamp);
+}
+
+/** Load and verify the previous snapshot before it can contribute archive-only messages. */
+export async function resolveArchiveMessages(
+  entries: readonly ConversationHistoryEntry[],
+  summary: ArchiveInstanceSummary,
+  current: OutputMessage[],
+  load: (entryId: string) => Promise<ConversationData | null>,
+): Promise<{ messages: OutputMessage[]; coverage?: ArchiveHistoryCoverage }> {
+  const identity = getArchiveHistoryIdentity(summary);
+  if (!identity) return { messages: current };
+  const conversations = new Map<string, ConversationData>();
+  const coverage = (await resolveHistoryRecoveryCoverage(entries, [identity], async entryId => {
+    const conversation = await load(entryId);
+    if (conversation) conversations.set(entryId, conversation);
+    return conversation;
+  })).get(identity.recoveryKey);
+  const previous = coverage ? conversations.get(coverage.historyEntryId) : undefined;
+  const indexed = entries.find(entry => entry.id === previous?.entry.id);
+  const previousSessionId = previous?.entry.sessionId?.trim();
+  // A revival may replay into a fresh provider session while retaining its
+  // logical thread. Other runtime sessions still replace rather than merge.
+  // Always reject a file whose source generation disagrees with its index.
+  const sameGeneration = previous && indexed
+    && previous.entry.originalInstanceId === indexed.originalInstanceId
+    && previous.entry.sessionId === indexed.sessionId
+    && (summary.metadata?.['continuityRevival'] === true
+      || (Boolean(previousSessionId)
+        && [summary.providerSessionId?.trim(), summary.sessionId?.trim()]
+          .includes(previousSessionId)));
+  return {
+    messages: sameGeneration ? mergeArchiveMessages(previous.messages, current) : current,
+    coverage,
+  };
+}
